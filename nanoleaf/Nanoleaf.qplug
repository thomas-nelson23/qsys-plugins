--[[ Nanoleaf Open API control plugin for Q-SYS
  Controls Nanoleaf Light Panels (Aurora), Canvas, Shapes, Elements and Lines
  over the local Nanoleaf Open API (HTTP, port 16021).

  References:
    Nanoleaf Open API documentation  - https://forum.nanoleaf.me/docs/openapi
    Q-SYS Plugin / Lua documentation - https://help.qsys.com/Content/Control_Scripting/Using_Lua_in_Q-Sys/HttpClient.htm
]]

PluginInfo = {
  Name = "Lighting~Nanoleaf Open API",
  Version = "1.2",
  BuildVersion = "1.2.0.0",
  Id = "8ad083e0-b14d-4387-8671-9b4053ac46a4",
  Author = "AV Programming",
  Description = "Control Nanoleaf lights (power, brightness, color, color temperature, effects, rhythm, per-panel color) over the local Nanoleaf Open API.",
  ShowDebug = true,
}

-- Palette: Console style guide kit + Nanoleaf brand accent ----------------
local ACCENT = { 62, 181, 74 }  -- Nanoleaf green (schematic block color only; pages use the shared theme)

--[[ Deep Ocean theme for Q-SYS plugins, v2.0 (2026-10-15)
     The home-dash design system (thomas-nelson23/home-dashboard, web/src/styles.css + theme.css)
     translated into what GetControlLayout can draw. Paste this block into a .qplug above
     GetControlLayout, then:

       function GetControlLayout(props)
         local layout, graphics = {}, {}
         local ui = Theme.kit(layout, graphics)
         ui.page(600)
         ui.header("PHILIPS|HUE", "Control", "BridgeName", "Status", "Online", 1)
         ui.section("Power", 8, 64, 200, 160)
         ui.button("Power", "POWER", 24, 96, 168, 48, "power")
         ...
         ui.hint("Pick a room, then use the pads.", 568)
         return layout, graphics
       end

     Every property used here is a documented GetControlLayout property:
     https://help.qsys.com/DeveloperHelp/Content/Standards_Definitions/Reserved_Functions.htm
     Guide: design/README.md in thomas-nelson23/qsys-plugins.
]]
local Theme = {}

Theme.W = 640   -- page width; every page is 640 wide
Theme.GRID = 8  -- positions and sizes snap to 8 (4 for fine alignment inside a row)

-- home-dash tokens. Glass and hairline colors are pre-blended over the panel or the
-- field, because Q-SYS draws solid fills (comments give the CSS each one comes from).
Theme.N = {
  bg      = { 2, 29, 46 },     -- --field #021d2e: the one flat deep-blue field
  panel   = { 6, 18, 27 },     -- .panel/.tile: rgba(--ink 4,12,18, .62-.93) glass over the field
  strip   = { 8, 27, 37 },     -- --surface-hi rgba(cyan, .045): a tile or row inside a panel
  rowAlt  = { 12, 24, 33 },    -- rgba(255,255,255,.025): alternate list row
  well    = { 4, 13, 19 },     -- .field input rgba(0,0,0,.3): readouts, fields, meters, hint bar
  stroke  = { 25, 41, 50 },    -- --glass-edge rgba(200,245,255,.1): panel and input edges
  hair    = { 20, 31, 40 },    -- --hair rgba(255,255,255,.055): dividers
  line    = { 10, 37, 50 },    -- --line rgba(cyan,.1)
  lineStrong = { 16, 72, 91 }, -- --line-strong rgba(cyan,.28): button and field outlines
  btn     = { 12, 24, 33 },    -- .btn background rgba(255,255,255,.025)
  btnOn   = { 25, 41, 50 },    -- .btn:hover, lifted
  ledOff  = { 0, 0, 0, 0 },    -- .led-off: hollow, only the ring shows
  white   = { 255, 255, 255 }, -- headings and big values (#fff)
  text    = { 217, 238, 242 }, -- --text #d9eef2
  sub     = { 156, 199, 207 }, -- --text-soft #9cc7cf: labels, secondary values
  dim     = { 95, 114, 122 },  -- --text-dim #5f727a: section titles, notes, units
  off     = { 58, 70, 80 },    -- --off #3a4650
  ink     = { 11, 15, 28 },    -- #0b0f1c: text on a solid cyan or white fill
}

-- Semantic colors: same meaning in every plugin. Cyan is also the only accent.
Theme.S = {
  ok    = { 42, 212, 255 },  -- --cyan #2ad4ff (Deep Ocean): good, online, on, the accent
  warn  = { 255, 176, 32 },  -- --warn #ffb020: attention only, always with a label
  fault = { 255, 42, 79 },   -- --red #ff2a4f: bad/offline, destructive actions, small signals
}

function Theme.mix(a, b, t)  -- t = 0 gives a, t = 1 gives b
  return { math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
           math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
           math.floor(a[3] + (b[3] - a[3]) * t + 0.5) }
end

-- home-dash has one accent, cyan. Theme.brand keeps the v1 field names so plugin code that
-- reads ui.B still works; the accent argument is accepted and ignored.
function Theme.brand()
  local cyan, panel = Theme.S.ok, Theme.N.panel
  return {
    accent = cyan,                        -- fader/knob/meter fill, on state of solid controls
    on     = Theme.mix(panel, cyan, 0.45), -- lit button fill (cyan at 45% over the panel)
    soft   = Theme.mix(panel, cyan, 0.08), -- --cyan-soft: .btn-accent and pad off state
    edge   = Theme.mix(panel, cyan, 0.45), -- rgba(cyan,.45): .btn-accent border
    dim    = Theme.mix(panel, cyan, 0.08), -- v1 name for soft
    pad    = Theme.mix(panel, cyan, 0.08), -- v1 name for soft
    ink    = cyan,                        -- cyan text (.lcd-inline, .bar-rest)
  }
end

-- Fonts. Q-SYS ships a fixed font list; these are the closest stand-ins for home-dash's
-- Sora (text), JetBrains Mono (numbers, ids) and Michroma (wordmark, display).
local FONT, MONO, DISPLAY = "Poppins", "Roboto Mono", "Montserrat"

local CUBE_SVG = "PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9Ii0xMDAgLTEwMCAyMDAgMjAwIj48ZyBm"
  .. "aWxsPSJub25lIiBzdHJva2U9IiMyYWQ0ZmYiIHN0cm9rZS13aWR0aD0iNy4wIiBzdHJva2UtbGluZWNhcD0icm91bmQiPjxw"
  .. "YXRoIHN0cm9rZS1vcGFjaXR5PSIwLjE3NiIgZD0iTS0wLjAsODAuM0wtNzAuNyw0Mi4xTS0wLjAsODAuM0w3MC43LDQyLjFN"
  .. "MjMuNiw2Ny41TC00Ny4xLDI5LjNNLTIzLjYsNjcuNUw0Ny4xLDI5LjNNNDcuMSw1NC44TC0yMy42LDE2LjZNLTQ3LjEsNTQu"
  .. "OEwyMy42LDE2LjZNNzAuNyw0Mi4xTDAuMCwzLjlNLTcwLjcsNDIuMUwwLjAsMy45TTcwLjcsNDIuMUw3MC43LC00Mi4xTTcw"
  .. "LjcsNDIuMUwwLjAsMy45TTQ3LjEsMjkuM0w0Ny4xLC01NC44TTcwLjcsMTQuMEwwLjAsLTI0LjJNMjMuNiwxNi42TDIzLjYs"
  .. "LTY3LjVNNzAuNywtMTQuMEwwLjAsLTUyLjJNMC4wLDMuOUwwLjAsLTgwLjNNNzAuNywtNDIuMUwwLjAsLTgwLjNNLTcwLjcs"
  .. "NDIuMUwtNzAuNywtNDIuMU0tNzAuNyw0Mi4xTDAuMCwzLjlNLTQ3LjEsMjkuM0wtNDcuMSwtNTQuOE0tNzAuNywxNC4wTDAu"
  .. "MCwtMjQuMk0tMjMuNiwxNi42TC0yMy42LC02Ny41TS03MC43LC0xNC4wTDAuMCwtNTIuMk0wLjAsMy45TDAuMCwtODAuM00t"
  .. "NzAuNywtNDIuMUwwLjAsLTgwLjMiLz48cGF0aCBzdHJva2Utb3BhY2l0eT0iMC44IiBkPSJNLTAuMCwtMy45TC03MC43LC00"
  .. "Mi4xTS0wLjAsLTMuOUw3MC43LC00Mi4xTTIzLjYsLTE2LjZMLTQ3LjEsLTU0LjhNLTIzLjYsLTE2LjZMNDcuMSwtNTQuOE00"
  .. "Ny4xLC0yOS4zTC0yMy42LC02Ny41TS00Ny4xLC0yOS4zTDIzLjYsLTY3LjVNNzAuNywtNDIuMUwwLjAsLTgwLjNNLTcwLjcs"
  .. "LTQyLjFMMC4wLC04MC4zTS0wLjAsODAuM0wtMC4wLC0zLjlNLTAuMCw4MC4zTC03MC43LDQyLjFNLTIzLjYsNjcuNUwtMjMu"
  .. "NiwtMTYuNk0tMC4wLDUyLjJMLTcwLjcsMTQuME0tNDcuMSw1NC44TC00Ny4xLC0yOS4zTS0wLjAsMjQuMkwtNzAuNywtMTQu"
  .. "ME0tNzAuNyw0Mi4xTC03MC43LC00Mi4xTS0wLjAsLTMuOUwtNzAuNywtNDIuMU0tMC4wLDgwLjNMLTAuMCwtMy45TS0wLjAs"
  .. "ODAuM0w3MC43LDQyLjFNMjMuNiw2Ny41TDIzLjYsLTE2LjZNLTAuMCw1Mi4yTDcwLjcsMTQuME00Ny4xLDU0LjhMNDcuMSwt"
  .. "MjkuM00tMC4wLDI0LjJMNzAuNywtMTQuME03MC43LDQyLjFMNzAuNywtNDIuMU0tMC4wLC0zLjlMNzAuNywtNDIuMSIvPjwv"
  .. "Zz48L3N2Zz4="

local function merge(t, extra)
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

function Theme.kit(layout, graphics)
  local N, S, B = Theme.N, Theme.S, Theme.brand()
  local ui = { N = N, S = S, B = B }

  local function g(t) table.insert(graphics, t) end
  local function box(x, y, w, h, fill, stroke, radius)
    g({ Type = "GroupBox", Fill = fill, StrokeColor = stroke or fill, StrokeWidth = stroke and 1 or 0,
        CornerRadius = radius or 0, Position = { x, y }, Size = { w, h } })
  end

  -- Static text. size: 10 hint/title, 11 label, 12 body, 13 emphasis
  function ui.label(text, x, y, w, h, align, size, color, style)
    g({ Type = "Label", Text = text, Font = FONT, FontStyle = style or "Regular", FontSize = size or 11,
        HTextAlign = align or "Right", Color = color or N.sub, Position = { x, y }, Size = { w, h or 20 } })
  end

  -- Page background: one flat field, no glows. Call first so it sits behind everything.
  function ui.page(h)
    box(0, 0, Theme.W, h, N.bg)
  end

  -- The wireframe cube from home-dash's backdrop, frozen at its starting pose
  -- (the frame home-dash shows when motion is reduced). s = size in px.
  function ui.cube(x, y, s)
    g({ Type = "Svg", Image = CUBE_SVG, Position = { x, y }, Size = { s, s } })
  end
  ui.sun = ui.cube  -- v1 name

  -- The front window's top edge: transparent > cyan > red > transparent, in 24 px steps.
  function ui.edge(x, y, w, base)
    local n = math.floor(w / 24)
    for i = 0, n - 1 do
      local t = (i + 0.5) / n
      local c
      if t < 0.25 then c = Theme.mix(base, S.ok, t / 0.25)
      elseif t < 0.75 then c = Theme.mix(S.ok, S.fault, (t - 0.25) / 0.5)
      else c = Theme.mix(S.fault, base, (t - 0.75) / 0.25) end
      box(x + i * 24, y, (i == n - 1) and (w - i * 24) or 24, 1, c)
    end
  end

  -- Top bar: cube, wordmark (Michroma stand-in; text after "|" is red, like "home|dash"),
  -- page number (red, mono) and page name like the numbered menu, device name, Status, Online LED.
  function ui.header(wordmark, pageName, nameCtl, statusCtl, ledCtl, pageNo)
    box(8, 8, 624, 48, N.panel, N.stroke, 8)
    ui.edge(16, 8, 608, N.stroke)
    ui.cube(18, 16, 32)
    local a, b = wordmark:match("^(.-)|(.*)$")
    a, b = string.upper(a or wordmark), string.upper(b or "")
    -- Q-SYS can't measure text, so the white part is right-aligned and the red part
    -- left-aligned on one seam; only the seam position is estimated (caps ~8.5 px at 13 px).
    local seam = 58 + math.floor(#a * 8.5 + 0.5)
    g({ Type = "Label", Text = a, Font = DISPLAY, FontStyle = "Medium", FontSize = 13, HTextAlign = "Right",
        Color = N.white, Position = { seam - 104, 20 }, Size = { 104, 24 }, Padding = 0 })
    if b ~= "" then
      g({ Type = "Label", Text = b, Font = DISPLAY, FontStyle = "Medium", FontSize = 13, HTextAlign = "Left",
          Color = S.fault, Position = { seam, 20 }, Size = { 104, 24 }, Padding = 0 })
    end
    if pageNo then
      g({ Type = "Label", Text = string.format("%02d", pageNo), Font = MONO, FontSize = 10, HTextAlign = "Left",
          Color = S.fault, Position = { 160, 22 }, Size = { 20, 20 } })
    end
    g({ Type = "Label", Text = string.upper(pageName), Font = FONT, FontStyle = "Medium", FontSize = 10,
        HTextAlign = "Left", Color = N.white, Position = { 180, 22 }, Size = { 96, 20 } })
    if nameCtl then ui.value(nameCtl, nil, 280, 20, 164, 24, { Color = N.panel, TextColor = N.sub, FontSize = 12 }) end
    if statusCtl then
      layout[statusCtl] = { PrettyName = "Status", Style = "Text", Position = { 452, 20 }, Size = { 140, 24 },
        Font = FONT, FontSize = 11, CornerRadius = 12 }
    end
    if ledCtl then ui.led(ledCtl, "Online", 602, 24, 16, "ok") end
  end

  -- Panel: glass card with a hairline edge, a small red signal, an uppercase dim title
  -- and a hairline under the title. Content starts 32 px below y.
  function ui.section(title, x, y, w, h)
    box(x, y, w, h, N.panel, N.stroke, 8)
    if title and title ~= "" then
      g({ Type = "GroupBox", StrokeColor = S.fault, StrokeWidth = 1, CornerRadius = 4,
          Position = { x + 12, y + 10 }, Size = { 8, 8 } })
      ui.label(string.upper(title), x + 26, y + 4, w - 38, 20, "Left", 10, N.dim, "SemiBold")
      box(x + 1, y + 27, w - 2, 1, N.hair)
    end
  end

  -- Tile inside a panel.
  function ui.strip(x, y, w, h)
    box(x, y, w, h, N.strip, N.hair, 8)
  end

  -- List row: every other row gets the faint lift.
  function ui.row(x, y, w, h, i)
    box(x, y, w, h, (i % 2 == 0) and N.rowAlt or N.strip, nil, 4)
  end

  -- Hint bar: one line of help per page, at the bottom.
  function ui.hint(text, y)
    g({ Type = "Label", Text = text, Font = FONT, FontSize = 10, HTextAlign = "Left", Color = N.dim, Fill = N.well,
        StrokeColor = N.hair, StrokeWidth = 1, CornerRadius = 8, Margin = 0, Padding = 8,
        Position = { 8, y }, Size = { 624, 24 } })
  end

  -- Buttons. kind (home-dash class in brackets):
  --   "primary"   toggle; dark pill, cyan when on            (.btn / .seg-btn.on)
  --   "secondary" cyan-tinted pill, cyan legend              (.btn-accent)
  --   "utility"   plain pill, soft legend                    (.btn)
  --   "pad"       preset tile, 8 px corners, cyan when on    (.tile-layouts button)
  --   "power"     the page's main action, bold               (.btn-accent, larger)
  --   "warn" / "danger" / "ok"  semantic tint and legend     (.banner-warn / .btn-danger)
  -- Pass ButtonStyle ("Toggle", "Momentary", "Trigger"...) in extra to match the control's ButtonType.
  local function tint(c, a) return Theme.mix(N.panel, c, a) end
  local KINDS = {
    primary   = { on = B.on, off = N.btn, text = N.text, stroke = N.lineStrong, pill = true, style = "SemiBold" },
    secondary = { on = B.on, off = B.soft, text = S.ok, stroke = B.edge, pill = true, style = "SemiBold" },
    utility   = { on = N.btnOn, off = N.btn, text = N.sub, stroke = N.lineStrong, pill = true, style = "SemiBold" },
    pad       = { on = B.on, off = N.strip, text = N.text, stroke = N.line, pill = false, style = "Medium" },
    power     = { on = B.on, off = N.btn, text = N.white, stroke = B.edge, pill = true, style = "Bold", size = 16 },
    warn      = { on = tint(S.warn, 0.25), off = tint(S.warn, 0.06), text = S.warn, stroke = tint(S.warn, 0.3), pill = true, style = "SemiBold" },
    danger    = { on = tint(S.fault, 0.25), off = tint(S.fault, 0.1), text = S.fault, stroke = tint(S.fault, 0.45), pill = true, style = "SemiBold" },
    ok        = { on = tint(S.ok, 0.25), off = B.soft, text = S.ok, stroke = B.edge, pill = true, style = "SemiBold" },
  }
  function ui.button(name, legend, x, y, w, h, kind, extra)
    local k = KINDS[kind or "primary"] or KINDS.primary
    h = h or 28
    layout[name] = merge({ PrettyName = name, Style = "Button", Legend = legend, Position = { x, y }, Size = { w, h },
      Color = k.on, OffColor = k.off, UnlinkOffColor = true, TextColor = k.text, StrokeColor = k.stroke, StrokeWidth = 1,
      Font = FONT, FontStyle = k.style, FontSize = k.size or 12,
      CornerRadius = k.pill and math.floor(math.min(w, h) / 2) or 8, ButtonVisualStyle = "Flat", Margin = 0, WordWrap = true }, extra)
  end

  -- Read-only readout: dark well, mono digits, no outline.
  function ui.readout(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h or 24 },
      Color = N.well, TextColor = N.text, Font = MONO, FontStyle = "Regular", FontSize = 12, HTextAlign = "Left",
      CornerRadius = 8, StrokeColor = N.well, StrokeWidth = 0, Padding = 4 }, extra)
  end

  -- Editable field: same well, plus the cyan-tinted outline so it reads as typeable.
  function ui.field(name, pretty, x, y, w, h, extra)
    ui.readout(name, pretty, x, y, w, h, merge({ StrokeColor = N.lineStrong, StrokeWidth = 1 }, extra))
  end

  -- Plain value text on the panel (names, secondary info). No well.
  function ui.value(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h or 20 },
      Color = N.panel, TextColor = N.text, Font = FONT, FontSize = 12, HTextAlign = "Left", StrokeWidth = 0,
      TextBoxStyle = "NoBackground" }, extra)
  end

  function ui.combo(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "ComboBox", Position = { x, y }, Size = { w, h or 24 },
      Color = N.well, TextColor = N.text, Font = FONT, FontSize = 12, StrokeColor = N.stroke, StrokeWidth = 1,
      CornerRadius = 8 }, extra)
  end

  -- Fader: horizontal when w > h, vertical when h > w. Cyan unless the color is the content.
  function ui.fader(name, pretty, x, y, w, h, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Fader", Position = { x, y }, Size = { w, h },
      Color = color or B.accent }, extra)
  end

  -- Knob: secondary parameters only (trim, fade time, step). 36 or 48 square.
  function ui.knob(name, pretty, x, y, s, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Knob", Position = { x, y }, Size = { s or 36, s or 36 },
      Color = color or B.accent }, extra)
  end

  -- Status dot. kind: "ok" | "warn" | "fault" | "accent" | an RGB table (e.g. a color swatch).
  -- Off is hollow: only the dim ring shows (.led-off).
  function ui.led(name, pretty, x, y, s, kind, extra)
    local c = type(kind) == "table" and kind or (kind == "accent" and B.accent) or S[kind or "ok"] or S.ok
    layout[name] = merge({ PrettyName = pretty or name, Style = "Led", Position = { x, y }, Size = { s or 16, s or 16 },
      Color = c, OffColor = N.ledOff, UnlinkOffColor = true, StrokeColor = N.dim, StrokeWidth = 1, Margin = 3 }, extra)
  end

  -- Meter: thin cyan bar on a faint track, no built-in text box (put a readout next to it).
  function ui.meter(name, pretty, x, y, w, h, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Meter", MeterStyle = "Standard", Position = { x, y },
      Size = { w, h }, Color = color or B.accent, BackgroundColor = Theme.mix(N.panel, N.white, 0.06), CornerRadius = 2,
      ShowTextbox = false, StrokeWidth = 0 }, extra)
  end

  -- Hide a control but keep its pins.
  function ui.hide(name, pretty)
    layout[name] = { PrettyName = pretty or name, Style = "None", Position = { 0, 0 }, Size = { 0, 0 } }
  end

  return ui
end

local QuickColors = {
  {"Red",    {255, 0, 0}},     {"Orange", {255, 110, 0}},
  {"Yellow", {255, 210, 0}},   {"Green",  {0, 220, 60}},
  {"Cyan",   {0, 210, 230}},   {"Blue",   {0, 70, 255}},
  {"Purple", {150, 40, 255}},  {"Pink",   {255, 60, 170}},
}
local WhitePresets = { {"Candle", 1900}, {"Warm", 2700}, {"Neutral", 4000}, {"Daylight", 5000}, {"Cool", 6500} }
local EFFECT_BUTTONS = 12

--[[ "Rad" theme for TSC-101-G3 UCI pages, v1.0 (2026-10-19)
     A loud 80s/90s look styled after the Pit Viper website (pitviper.com): neon hot pink,
     electric yellow, cyan and orange on a purple-black field, heavy italic type, hard offset
     shadows, sunset stripes, a sliced retro sun, a grid and a checkerboard.
     Pages are 1280 x 800, the 16:10 shape of the Q-SYS TSC-101-G3 (1920 x 1200 native).
     The static artwork is one SVG per page (documented "Svg" graphic, Base-64 Image),
     built here so the active nav tab and the cards line up with the controls.
     Q-SYS layouts have no gradients, glows or blur, so: sunset gradient = flat bands,
     neon glow = a hard offset shadow, chrome = flat light grey.
     Properties used are the documented GetControlLayout ones:
     https://help.qsys.com/DeveloperHelp/Content/Standards_Definitions/Reserved_Functions.htm
]]
local Rad = {}

Rad.W, Rad.H = 1280, 800

Rad.C = {
  night  = { 20, 10, 40 },    -- page field, purple-black
  ink    = { 10, 5, 20 },     -- cards, wells, and text on a neon fill
  grid   = { 40, 24, 78 },    -- background grid lines
  pink   = { 255, 46, 147 },  -- hot pink
  yellow = { 255, 230, 0 },   -- electric yellow
  cyan   = { 0, 229, 255 },   -- cyan
  orange = { 255, 122, 0 },   -- orange
  purple = { 150, 70, 255 },  -- violet
  lime   = { 170, 255, 0 },   -- LED "on"
  white  = { 255, 255, 255 },
  chrome = { 214, 220, 235 }, -- flat stand-in for chrome lettering
  off    = { 64, 48, 100 },   -- unlit LED, disabled
}

Rad.TABS = { "HOME", "COLOR", "FX", "PANELS" }

local function hexc(c) return string.format("#%02x%02x%02x", c[1], c[2], c[3]) end

local B64C = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64(s)
  local out, n = {}, #s
  for i = 1, n, 3 do
    local a, b, c = s:byte(i, i + 2)
    local v = a * 65536 + (b or 0) * 256 + (c or 0)
    local c1, c2 = v // 262144 % 64, v // 4096 % 64
    local c3, c4 = v // 64 % 64, v % 64
    out[#out + 1] = B64C:sub(c1 + 1, c1 + 1) .. B64C:sub(c2 + 1, c2 + 1)
      .. (b and B64C:sub(c3 + 1, c3 + 1) or "=") .. (c and B64C:sub(c4 + 1, c4 + 1) or "=")
  end
  return table.concat(out)
end

local function merge2(t, extra)
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

-- tab = 1..4: which nav tab is lit on this page
function Rad.kit(layout, graphics, tab)
  local C = Rad.C
  local r = { C = C }
  local svg = {}
  local labels = {}

  local function s(fmt, ...) svg[#svg + 1] = string.format(fmt, ...) end
  local function rect(x, y, w, h, fill, stroke, sw)
    if stroke then
      s('<rect x="%g" y="%g" width="%g" height="%g" fill="%s" stroke="%s" stroke-width="%g"/>',
        x, y, w, h, fill and hexc(fill) or "none", hexc(stroke), sw or 4)
    else
      s('<rect x="%g" y="%g" width="%g" height="%g" fill="%s"/>', x, y, w, h, hexc(fill))
    end
  end
  local function poly(pts, fill, stroke, sw)
    local p = {}
    for i = 1, #pts, 2 do p[#p + 1] = string.format("%g,%g", pts[i], pts[i + 1]) end
    s('<polygon points="%s" fill="%s"%s/>', table.concat(p, " "), fill and hexc(fill) or "none",
      stroke and string.format(' stroke="%s" stroke-width="%g" stroke-linejoin="round"', hexc(stroke), sw or 3) or "")
  end
  r.rect, r.poly = rect, poly

  -- Static text. Montserrat is the heaviest face on the Q-SYS font list; Black Italic is the
  -- stand-in for the site's chunky slanted display type.
  function r.text(text, x, y, w, h, size, color, align, style, font)
    labels[#labels + 1] = { Type = "Label", Text = text, Font = font or "Montserrat",
      FontStyle = style or "Black Italic", FontSize = size or 16, HTextAlign = align or "Left",
      Color = color or C.white, Position = { x, y }, Size = { w, h }, Padding = 0, Margin = 0 }
  end
  -- Shouty text with a hard offset shadow (stand-in for a neon glow).
  function r.shout(text, x, y, w, h, size, color, shadow, dx)
    r.text(text, x + (dx or 4), y + (dx or 4), w, h, size, shadow or C.pink)
    r.text(text, x, y, w, h, size, color or C.yellow)
  end

  -- Approximate text width for Montserrat Black Italic caps (Q-SYS can't measure text).
  local function capsW(text, size) return math.floor(#text * size * 0.74 + 0.5) end

  -- Sliced retro sun: flat bands with dark gaps that grow toward the horizon.
  local function sun(cx, cy, rad, bands)
    local top = cy - rad
    local n = #bands
    local bandH = rad / n
    for i, col in ipairs(bands) do
      local y1 = top + (i - 1) * bandH
      local gap = (i - 1) * 2
      local y2 = top + i * bandH - gap
      if y2 > y1 then
        local left, right = {}, {}
        for k = 0, 4 do
          local y = y1 + (y2 - y1) * k / 4
          local dx = math.sqrt(math.max(0, rad * rad - (y - cy) * (y - cy)))
          left[#left + 1] = { cx - dx, y }
          right[#right + 1] = { cx + dx, y }
        end
        local pts = {}
        for k = 1, #right do pts[#pts + 1] = right[k][1]; pts[#pts + 1] = right[k][2] end
        for k = #left, 1, -1 do pts[#pts + 1] = left[k][1]; pts[#pts + 1] = left[k][2] end
        poly(pts, col)
      end
    end
  end

  -- Page chrome: field, grid, header with wordmark and sun, sunset stripes, nav tabs, checkerboard.
  function r.page(slogan)
    rect(0, 0, Rad.W, Rad.H, C.night)
    for x = 0, Rad.W, 40 do rect(x, 140, 1, 560, C.grid) end
    for y = 140, 700, 40 do rect(0, y, Rad.W, 1, C.grid) end
    -- header
    rect(0, 0, Rad.W, 120, C.ink)
    sun(704, 120, 92, { C.yellow, C.yellow, C.orange, C.orange, C.pink, C.pink, C.purple })
    -- Memphis confetti
    poly({ 470, 30, 494, 70, 446, 70 }, nil, C.cyan, 3)
    s('<path d="M 530 92 l 12 -12 l 12 12 l 12 -12 l 12 12 l 12 -12" fill="none" stroke="%s" stroke-width="4" stroke-linejoin="round"/>', hexc(C.pink))
    s('<circle cx="860" cy="30" r="6" fill="%s"/><circle cx="884" cy="82" r="4" fill="%s"/><circle cx="420" cy="96" r="5" fill="%s"/>',
      hexc(C.yellow), hexc(C.cyan), hexc(C.orange))
    poly({ 820, 64, 836, 56, 844, 72, 828, 80 }, C.lime)
    -- sunset stripes (flat bands standing in for a gradient)
    local stripes = { C.yellow, C.orange, C.pink, C.purple, C.cyan }
    for i, c in ipairs(stripes) do rect(0, 120 + (i - 1) * 4, Rad.W, 4, c) end
    -- nav tabs: slanted stickers; drop UCI Navigation Buttons on them (see README)
    for i, t in ipairs(Rad.TABS) do
      local x, y, w, h, k = 32 + (i - 1) * 236, 712, 220, 52, 16
      local on = (i == tab)
      if on then poly({ x + k + 6, y + 6, x + w + 6, y + 6, x + w - k + 6, y + h + 6, x + 6, y + h + 6 }, C.pink) end
      poly({ x + k, y, x + w, y, x + w - k, y + h, x, y + h }, on and C.yellow or C.ink, on and C.ink or C.cyan, on and 0 or 3)
      r.text(t, x, y + 12, w, 28, 22, on and C.ink or C.cyan, "Center")
    end
    if slogan then r.text(slogan, 980, 722, 268, 32, 18, C.pink, "Right") end
    -- checkerboard
    rect(0, 772, Rad.W, 28, C.white)
    for row = 0, 1 do
      for col = 0, Rad.W // 14 do
        if (col + row) % 2 == 0 then rect(col * 14, 772 + row * 14, 14, 14, C.ink) end
      end
    end
    -- wordmark and tagline
    r.shout("NANOLEAF", 32, 16, 420, 64, 52, C.yellow, C.pink, 5)
    r.text("LIGHT CONTROL", 36, 82, 200, 24, 16, C.cyan, "Left", "ExtraBold Italic")
    r.text("MAXIMUM RAD", 210, 82, 200, 24, 16, C.white, "Left", "ExtraBold Italic")
  end

  -- Header status: device name, Q-SYS status, Online LED.
  function r.status(nameCtl, statusCtl, ledCtl)
    r.text("DEVICE", 868, 18, 160, 18, 12, C.pink, "Left", "ExtraBold Italic")
    r.text("STATUS", 1040, 18, 160, 18, 12, C.pink, "Left", "ExtraBold Italic")
    layout[nameCtl] = { PrettyName = "Device Name", Style = "Text", Position = { 868, 40 }, Size = { 160, 40 },
      Color = C.ink, TextColor = C.white, Font = "Montserrat", FontStyle = "Bold", FontSize = 16, HTextAlign = "Left",
      StrokeWidth = 0, TextBoxStyle = "NoBackground", IsReadOnly = true }
    layout[statusCtl] = { PrettyName = "Status", Style = "Text", Position = { 1040, 40 }, Size = { 160, 40 },
      Font = "Montserrat", FontStyle = "Bold", FontSize = 14, CornerRadius = 0, StrokeWidth = 0 }
    layout[ledCtl] = { PrettyName = "Online", Style = "Led", Position = { 1212, 44 }, Size = { 32, 32 },
      Color = C.lime, OffColor = C.off, UnlinkOffColor = true, StrokeColor = C.white, StrokeWidth = 2, Margin = 2 }
  end

  -- Card: ink fill, thick neon edge, hard offset shadow, and a slanted title sticker that
  -- overhangs the top edge (keep 20 px above the card free).
  function r.card(title, x, y, w, h, color, shadow)
    rect(x + 10, y + 10, w, h, shadow or C.pink)
    rect(x, y, w, h, C.ink, color, 4)
    if title then
      local tw = capsW(title, 22) + 40
      local sx, sy, sh, k = x + 20, y - 20, 40, 10
      poly({ sx + k, sy, sx + tw, sy, sx + tw - k, sy + sh, sx, sy + sh }, color)
      r.text(title, sx, sy + 6, tw, 30, 22, C.ink, "Center")
    end
  end

  -- Small caption above a control.
  function r.cap(text, x, y, w, color, align)
    r.text(text, x, y, w, 22, 16, color or C.white, align or "Left", "ExtraBold Italic")
  end

  -- Diagonal hazard stripes (yellow / ink).
  function r.hazard(x, y, w, h)
    rect(x, y, w, h, C.yellow)
    for i = -h, w, 24 do
      local pts = { x + i, y + h, x + i + 12, y + h, x + i + 12 + h, y, x + i + h, y }
      -- clip by hand to the strip
      for p = 1, #pts, 2 do pts[p] = math.min(math.max(pts[p], x), x + w) end
      poly(pts, C.ink)
    end
  end

  -- Buttons. kind:
  --   "power"  big toggle: pink edge and legend, solid pink when on
  --   "hit"    trigger: solid yellow, ink legend, flashes white
  --   "zap"    trigger: solid cyan, ink legend
  --   "ghost"  trigger: ink with cyan edge and legend, fills cyan when pressed
  --   "pad"    toggle tile: ink with a neon edge, fills with that neon when on (pass color)
  --   "alert"  trigger: solid orange, ink legend (Identify)
  --   "swatch" trigger: the button's own color (quick colors, white presets)
  local KIND = {
    power = { on = C.pink, off = C.ink, text = C.white, stroke = C.pink, sw = 5, size = 48, style = "Black Italic" },
    hit   = { on = C.white, off = C.yellow, text = C.ink, stroke = C.ink, sw = 0, size = 24, style = "Black Italic" },
    zap   = { on = C.white, off = C.cyan, text = C.ink, stroke = C.ink, sw = 0, size = 22, style = "Black Italic" },
    ghost = { on = C.cyan, off = C.ink, text = C.cyan, stroke = C.cyan, sw = 3, size = 18, style = "ExtraBold Italic" },
    pad   = { on = C.yellow, off = C.ink, text = C.white, stroke = C.yellow, sw = 3, size = 18, style = "ExtraBold Italic" },
    alert = { on = C.white, off = C.orange, text = C.ink, stroke = C.ink, sw = 0, size = 30, style = "Black Italic" },
    swatch = { on = C.white, off = C.white, text = C.ink, stroke = C.ink, sw = 0, size = 16, style = "Black Italic" },
  }
  -- PrettyName is the control name, as on the plugin's own pages.
  function r.button(name, legend, x, y, w, h, kind, extra)
    local k = KIND[kind or "hit"]
    layout[name] = merge2({ PrettyName = name, Style = "Button", Legend = legend,
      Position = { x, y }, Size = { w, h }, Color = k.on, OffColor = k.off, UnlinkOffColor = true,
      TextColor = k.text, StrokeColor = k.stroke, StrokeWidth = k.sw, Font = "Montserrat", FontStyle = k.style,
      FontSize = k.size, CornerRadius = 4, ButtonVisualStyle = "Flat", ButtonStyle = "Trigger", Margin = 0,
      WordWrap = true }, extra)
  end

  function r.fader(name, pretty, x, y, w, h, color, extra)
    layout[name] = merge2({ PrettyName = pretty or name, Style = "Fader", Position = { x, y }, Size = { w, h },
      Color = color or C.yellow, ShowTextbox = false }, extra)
  end

  -- Read-only readout: ink well, mono digits in yellow.
  function r.readout(name, pretty, x, y, w, h, extra)
    layout[name] = merge2({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h },
      Color = C.ink, TextColor = C.yellow, Font = "Roboto Mono", FontStyle = "Bold", FontSize = 18,
      HTextAlign = "Center", CornerRadius = 0, StrokeColor = C.purple, StrokeWidth = 2, Padding = 4,
      IsReadOnly = true }, extra)
  end

  -- Editable field (opens the TSC keyboard): cyan edge.
  function r.field(name, pretty, x, y, w, h, extra)
    r.readout(name, pretty, x, y, w, h, merge2({ StrokeColor = C.cyan, StrokeWidth = 3, IsReadOnly = false }, extra))
  end

  -- Plain value text on a card.
  function r.value(name, pretty, x, y, w, h, extra)
    layout[name] = merge2({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h },
      Color = C.ink, TextColor = C.chrome, Font = "Montserrat", FontStyle = "Bold", FontSize = 16,
      HTextAlign = "Center", StrokeWidth = 0, TextBoxStyle = "NoBackground", IsReadOnly = true }, extra)
  end

  function r.combo(name, pretty, x, y, w, h, extra)
    layout[name] = merge2({ PrettyName = pretty or name, Style = "ComboBox", Position = { x, y }, Size = { w, h },
      Color = C.ink, TextColor = C.white, Font = "Montserrat", FontStyle = "Bold", FontSize = 18,
      StrokeColor = C.pink, StrokeWidth = 3, CornerRadius = 0 }, extra)
  end

  function r.led(name, pretty, x, y, sz, color, extra)
    layout[name] = merge2({ PrettyName = pretty or name, Style = "Led", Position = { x, y }, Size = { sz, sz },
      Color = color or C.lime, OffColor = C.off, UnlinkOffColor = true, StrokeColor = C.white, StrokeWidth = 2,
      Margin = 2 }, extra)
  end

  -- Call last: puts the page artwork behind everything as one Svg, then the text on top.
  function r.finish()
    local doc = string.format('<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">%s</svg>',
      Rad.W, Rad.H, Rad.W, Rad.H, table.concat(svg))
    table.insert(graphics, { Type = "Svg", Image = b64(doc), Position = { 0, 0 }, Size = { Rad.W, Rad.H }, ZOrder = -100 })
    for _, l in ipairs(labels) do table.insert(graphics, l) end
    r.svgText = doc
  end

  return r
end

-- TSC-101-G3 UCI pages (1280 x 800). Shown when the "TSC-101 UCI Pages" property is On.
-- Open one of these pages, press Ctrl+A (selects controls and graphics) and paste onto a
-- UCI page set to Panel Type TSC-101-G3, landscape. The pasted controls stay linked to this plugin.
local UciPages = { "TSC Home", "TSC Color", "TSC Effects", "TSC Panels" }

local function RadLayout(page, layout, graphics)
  local tab = ({ ["TSC Home"] = 1, ["TSC Color"] = 2, ["TSC Effects"] = 3, ["TSC Panels"] = 4 })[page]
  local r = Rad.kit(layout, graphics, tab)
  local C = r.C
  local slogans = { "SHADES ON. LIGHTS UP.", "TASTE THE RAINBOW.", "PARTY MODE: ARMED.", "EVERY PANEL. NO MERCY." }
  r.page(slogans[tab])
  r.status("DeviceName", "Status", "Online")

  if tab == 1 then
    -- Power
    r.card("POWER", 32, 180, 340, 500, C.pink, C.cyan)
    r.button("Power", "POWER", 56, 216, 292, 220, "power", { ButtonStyle = "Toggle" })
    r.button("PowerOn", "ON", 56, 456, 140, 72, "hit")
    r.button("PowerOff", "OFF", 208, 456, 140, 72, "ghost", { FontSize = 24, FontStyle = "Black Italic" })
    r.cap("NOW PLAYING", 56, 548, 292, C.cyan)
    r.readout("EffectCurrent", "Effects~Current", 56, 574, 292, 56, { FontSize = 16, WordWrap = true })
    -- Brightness
    r.card("BRIGHTNESS", 404, 180, 340, 500, C.yellow, C.pink)
    r.fader("Brightness", "Brightness~Level", 436, 220, 136, 436, C.yellow, { ShowTextbox = true })
    r.button("BrightnessUp", "+", 596, 220, 124, 120, "hit", { FontSize = 64 })
    r.button("BrightnessDown", "-", 596, 356, 124, 120, "zap", { FontSize = 64 })
    r.cap("FADE (S)", 596, 504, 124, C.yellow, "Center")
    r.field("FadeTime", "Brightness~Fade Time", 596, 532, 124, 56, { FontSize = 22 })
    r.text("0 = SNAP", 596, 600, 124, 20, 13, C.chrome, "Center", "Bold Italic")
    -- Quick hits
    r.card("QUICK HITS", 776, 180, 472, 500, C.cyan, C.yellow)
    for i, qc in ipairs(QuickColors) do
      local c = qc[2]
      local col, row = (i - 1) % 4, (i - 1) // 4
      r.button("QuickColor " .. i, string.upper(qc[1]), 800 + col * 109, 220 + row * 92, 97, 80,
        "swatch", { OffColor = c, Color = C.white,
          TextColor = (c[1] * 0.3 + c[2] * 0.59 + c[3] * 0.11 < 110) and C.white or C.ink })
    end
    r.cap("WHITES", 800, 410, 200, C.cyan)
    for i, wp in ipairs(WhitePresets) do
      local k = math.floor((wp[2] - 1900) / (6500 - 1900) * 100 + 0.5) / 100
      local warm, cool = { 255, 170, 80 }, { 215, 235, 255 }
      local c = { math.floor(warm[1] + (cool[1] - warm[1]) * k), math.floor(warm[2] + (cool[2] - warm[2]) * k),
                  math.floor(warm[3] + (cool[3] - warm[3]) * k) }
      r.button("WhitePreset " .. i, string.upper(wp[1]), 800 + (i - 1) * 87, 436, 76, 64, "swatch",
        { OffColor = c, Color = C.white, FontSize = 12 })
    end
    r.cap("SCENES", 800, 520, 200, C.cyan)
    r.button("EffectPrev", "< PREV", 800, 546, 206, 72, "ghost", { FontSize = 22 })
    r.button("EffectNext", "NEXT >", 1018, 546, 206, 72, "hit")

  elseif tab == 2 then
    -- Color faders (fader colors are the content)
    r.card("COLOR LAB", 32, 180, 800, 340, C.pink, C.yellow)
    local rows = { { "Hue", "HUE", C.pink }, { "Saturation", "SAT", C.cyan }, { "Red", "RED", { 255, 40, 60 } },
                   { "Green", "GREEN", { 60, 255, 90 } }, { "Blue", "BLUE", { 60, 110, 255 } } }
    for i, row in ipairs(rows) do
      local y = 224 + (i - 1) * 56
      r.text(row[2], 56, y + 8, 112, 30, 24, row[3], "Left")
      r.fader(row[1], "Color~" .. row[1], 176, y, 632, 44, row[3])
    end
    r.card("SWATCH", 864, 180, 384, 340, C.cyan, C.pink)
    r.led("ColorSwatch", "Color~Swatch", 888, 228, 168, C.white, { Margin = 0, StrokeWidth = 4 })
    r.cap("HEX", 1072, 228, 152, C.cyan)
    r.field("HexColor", "Color~Hex", 1072, 254, 152, 56, { FontSize = 20 })
    r.cap("MODE", 1072, 330, 152, C.cyan)
    r.readout("ColorMode", "Color~Mode", 1072, 356, 152, 48, { FontSize = 16 })
    r.text("WHAT YOU SEE IS WHAT YOU GLOW", 888, 440, 336, 24, 15, C.pink, "Left", "ExtraBold Italic")
    -- White
    r.card("WHITE HEAT", 32, 560, 1216, 120, C.orange, C.purple)
    r.text("KELVIN", 56, 604, 112, 30, 24, C.orange, "Left")
    r.fader("ColorTemp", "White~Color Temp", 168, 596, 520, 48, C.orange)
    for i, wp in ipairs(WhitePresets) do
      r.button("WhitePreset " .. i, string.upper(wp[1]), 716 + (i - 1) * 100, 592, 92, 56,
        i % 2 == 1 and "hit" or "zap", { FontSize = 15 })
    end

  elseif tab == 3 then
    r.card("PICK A VIBE", 32, 180, 1216, 112, C.purple, C.cyan)
    r.combo("EffectSelect", "Effects~Select", 56, 212, 600, 56)
    r.button("EffectPrev", "< PREV", 680, 212, 140, 56, "ghost", { FontSize = 20 })
    r.button("EffectNext", "NEXT >", 832, 212, 140, 56, "hit", { FontSize = 20 })
    r.button("EffectRefresh", "RELOAD", 984, 212, 120, 56, "ghost", { FontSize = 16 })
    r.value("EffectCount", "Effects~Count", 1112, 212, 120, 56, { FontSize = 13, WordWrap = true })
    -- Effect pads: each pad has its own neon; it fills with it when that effect is playing
    r.card("PARTY PADS", 32, 332, 856, 348, C.yellow, C.pink)
    local neon = { C.pink, C.purple, C.orange, { 0, 120, 255 } }  -- dark enough for a white legend when lit
    for i = 1, EFFECT_BUTTONS do
      local col, row = (i - 1) % 4, (i - 1) // 4
      local c = neon[(col + row) % 4 + 1]
      r.button("EffectButton " .. i, "", 56 + col * 205, 372 + row * 84, 193, 72, "pad",
        { ButtonStyle = "Toggle", Color = c, StrokeColor = c, TextColor = C.white })
    end
    r.button("EffectPageDown", "< PAGE", 56, 624, 140, 48, "ghost", { FontSize = 18 })
    r.value("EffectPageLabel", "Effects~Page", 208, 624, 504, 48, { FontSize = 16 })
    r.button("EffectPageUp", "PAGE >", 724, 624, 140, 48, "ghost", { FontSize = 18 })
    -- Now playing and Rhythm
    r.card("NOW PLAYING", 920, 332, 328, 348, C.cyan, C.orange)
    r.readout("EffectCurrent", "Effects~Current", 944, 372, 280, 64, { FontSize = 18, WordWrap = true })
    r.cap("RHYTHM", 944, 456, 280, C.yellow)
    r.led("RhythmConnected", "Rhythm~Connected", 944, 488, 28, C.lime)
    r.text("MIC CONNECTED", 984, 492, 240, 22, 15, C.white, "Left", "ExtraBold Italic")
    r.led("RhythmActive", "Rhythm~Active", 944, 524, 28, C.pink)
    r.text("SOUND REACTIVE", 984, 528, 240, 22, 15, C.white, "Left", "ExtraBold Italic")
    r.cap("INPUT", 944, 566, 280, C.yellow)
    r.combo("RhythmMode", "Rhythm~Input", 944, 592, 280, 52, { FontSize = 16 })

  elseif tab == 4 then
    r.card("PANEL PICKER", 32, 180, 800, 500, C.cyan, C.pink)
    r.text("PANEL", 56, 230, 104, 30, 24, C.cyan, "Left")
    r.combo("PanelSelect", "Panels~Select", 160, 216, 360, 56)
    r.value("PanelInfo", "Panels~Info", 536, 216, 272, 56, { FontSize = 14, HTextAlign = "Left", WordWrap = true })
    local prow = { { "PanelRed", "RED", { 255, 40, 60 } }, { "PanelGreen", "GREEN", { 60, 255, 90 } },
                   { "PanelBlue", "BLUE", { 60, 110, 255 } } }
    for i, row in ipairs(prow) do
      local y = 300 + (i - 1) * 64
      r.text(row[2], 56, y + 10, 104, 30, 24, row[3], "Left")
      r.fader(row[1], "Panels~" .. row[1]:sub(6), 160, y, 648, 48, row[3])
    end
    r.cap("FADE (S)", 56, 512, 140, C.cyan)
    r.field("PanelTransition", "Panels~Transition", 168, 500, 120, 48, { FontSize = 20 })
    r.cap("PREVIEW", 600, 512, 120, C.cyan, "Right")
    r.led("PanelSwatch", "Panels~Swatch", 736, 488, 72, C.white, { Margin = 0, StrokeWidth = 3 })
    r.button("PanelApply", "PAINT PANEL", 56, 584, 360, 72, "hit", { FontSize = 26 })
    r.button("PanelApplyAll", "PAINT 'EM ALL", 432, 584, 376, 72, "zap", { FontSize = 26 })

    r.card("THE LAYOUT", 864, 180, 384, 500, C.orange, C.yellow)
    r.cap("PANELS", 888, 216, 336, C.orange)
    r.readout("PanelCount", "Panels~Count", 888, 242, 336, 72, { FontSize = 40 })
    r.cap("ROTATE", 888, 334, 200, C.orange)
    r.field("Orientation", "Panels~Orientation", 888, 360, 160, 56, { FontSize = 22 })
    r.text("DEGREES", 1064, 376, 160, 24, 16, C.chrome, "Left", "ExtraBold Italic")
    r.hazard(888, 440, 336, 16)
    r.button("Identify", "FIND 'EM!", 888, 472, 336, 112, "alert")
    r.hazard(888, 600, 336, 16)
    r.text("EVERY PANEL FLASHES", 888, 628, 336, 22, 15, C.chrome, "Center", "ExtraBold Italic")
  end

  r.finish()
  return r
end


function GetColor(props)
  return ACCENT
end

function GetPrettyName(props)
  return "Nanoleaf Open API v" .. PluginInfo.Version
end

local PageNames = { "Control", "Effects", "Panels", "Setup" }

-- Page list for these properties: the four plugin pages, plus the UCI pages when switched on.
local function PagesFor(props)
  local list = {}
  for _, n in ipairs(PageNames) do list[#list + 1] = n end
  local p = props and props["TSC-101 UCI Pages"]
  if p and p.Value == "On" then
    for _, n in ipairs(UciPages) do list[#list + 1] = n end
  end
  return list
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PagesFor(props)) do table.insert(pages, { name = name }) end
  return pages
end

function GetProperties()
  return {
    { Name = "Port", Type = "integer", Min = 1, Max = 65535, Value = 16021 },
    { Name = "Poll Interval (s)", Type = "integer", Min = 1, Max = 60, Value = 3 },
    { Name = "Debug Print", Type = "enum", Choices = { "None", "Errors", "All" }, Value = "Errors" },
    { Name = "TSC-101 UCI Pages", Type = "enum", Choices = { "Off", "On" }, Value = "Off" },
  }
end

function RectifyProperties(props)
  return props
end

function GetControls(props)
  local ctrls = {
    -- status
    { Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output", UserPin = true },
    { Name = "Online", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true },
    { Name = "DeviceName", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    -- power
    { Name = "Power", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both", UserPin = true },
    { Name = "PowerOn", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "PowerOff", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    -- brightness
    { Name = "Brightness", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, PinStyle = "Both", UserPin = true },
    { Name = "BrightnessUp", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "BrightnessDown", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "BrightnessStep", ControlType = "Knob", ControlUnit = "Integer", Min = 1, Max = 50, DefaultValue = 10, PinStyle = "Input", UserPin = true },
    { Name = "FadeTime", ControlType = "Knob", ControlUnit = "Seconds", Min = 0, Max = 60, DefaultValue = 0, PinStyle = "Input", UserPin = true },
    -- color
    { Name = "Hue", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 360, PinStyle = "Both", UserPin = true },
    { Name = "Saturation", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 100, PinStyle = "Both", UserPin = true },
    { Name = "Red", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, PinStyle = "Both", UserPin = true },
    { Name = "Green", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, PinStyle = "Both", UserPin = true },
    { Name = "Blue", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, PinStyle = "Both", UserPin = true },
    { Name = "HexColor", ControlType = "Text", PinStyle = "Both", UserPin = true },
    { Name = "ColorSwatch", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "None", UserPin = false },
    { Name = "ColorMode", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "QuickColor", ControlType = "Button", ButtonType = "Trigger", Count = #QuickColors, PinStyle = "Input", UserPin = true },
    -- white
    { Name = "ColorTemp", ControlType = "Knob", ControlUnit = "Integer", Min = 1200, Max = 6500, PinStyle = "Both", UserPin = true },
    { Name = "WhitePreset", ControlType = "Button", ButtonType = "Trigger", Count = #WhitePresets, PinStyle = "Input", UserPin = true },
    -- effects
    { Name = "EffectSelect", ControlType = "Text", PinStyle = "Both", UserPin = true },
    { Name = "EffectCurrent", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "EffectNext", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "EffectPrev", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "EffectRefresh", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "EffectCount", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "EffectButton", ControlType = "Button", ButtonType = "Toggle", Count = EFFECT_BUTTONS, PinStyle = "Both", UserPin = true },
    { Name = "EffectPageUp", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "EffectPageDown", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "EffectPageLabel", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "None", UserPin = false },
    -- rhythm
    { Name = "RhythmConnected", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true },
    { Name = "RhythmActive", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true },
    { Name = "RhythmMode", ControlType = "Text", PinStyle = "Both", UserPin = true },
    -- panels
    { Name = "PanelCount", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "Orientation", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 360, PinStyle = "Both", UserPin = true },
    { Name = "Identify", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "PanelSelect", ControlType = "Text", PinStyle = "Both", UserPin = true },
    { Name = "PanelInfo", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "None", UserPin = false },
    { Name = "PanelRed", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, DefaultValue = 255, PinStyle = "Input", UserPin = true },
    { Name = "PanelGreen", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, DefaultValue = 255, PinStyle = "Input", UserPin = true },
    { Name = "PanelBlue", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, DefaultValue = 255, PinStyle = "Input", UserPin = true },
    { Name = "PanelSwatch", ControlType = "Indicator", IndicatorType = "Led", PinStyle = "None", UserPin = false },
    { Name = "PanelApply", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "PanelApplyAll", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "PanelTransition", ControlType = "Knob", ControlUnit = "Seconds", Min = 0, Max = 10, DefaultValue = 1, PinStyle = "Input", UserPin = true },
    -- setup
    { Name = "IPAddress", ControlType = "Text", PinStyle = "Both", UserPin = true },
    { Name = "AuthToken", ControlType = "Text", PinStyle = "Both", UserPin = true },
    { Name = "Pair", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "Unpair", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "Connect", ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input", UserPin = true },
    { Name = "Model", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "SerialNumber", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "Firmware", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "Manufacturer", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
    { Name = "LastError", ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output", UserPin = true },
  }
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local page = PagesFor(props)[props["page_index"].Value]
  if page and page:sub(1, 4) == "TSC " then
    RadLayout(page, layout, graphics)
    return layout, graphics
  end
  local ui = Theme.kit(layout, graphics)
  local N, S = ui.N, ui.S

  local function lbl(text, x, y, w, align) ui.label(text, x, y, w, 20, align or "Right", 11) end
  local function note(text, x, y, w) ui.label(text, x, y, w, 16, "Left", 10, N.dim) end
  local function hdr()
    ui.header("NANO|LEAF", page, "DeviceName", "Status", "Online", props["page_index"].Value)
    layout["DeviceName"].PrettyName = "Device Name"
  end

  if page == "Control" then
    ui.page(664)
    hdr()
    -- Power
    ui.section("Power", 8, 64, 200, 160)
    ui.button("Power", "POWER", 24, 96, 168, 64, "power", { ButtonStyle = "Toggle" })
    ui.button("PowerOn", "On", 24, 172, 80, 36, "secondary")
    ui.button("PowerOff", "Off", 112, 172, 80, 36, "secondary")

    -- Brightness
    ui.section("Brightness", 216, 64, 416, 160)
    ui.fader("Brightness", "Brightness~Level", 232, 104, 296, 24)
    ui.button("BrightnessDown", "-", 536, 100, 36, 32, "utility", { FontSize = 18 })
    ui.button("BrightnessUp", "+", 580, 100, 36, 32, "utility", { FontSize = 18 })
    lbl("Step", 232, 170, 40)
    ui.field("BrightnessStep", "Brightness~Step", 280, 168, 64, 24, { HTextAlign = "Center" })
    lbl("Fade Time (s)", 360, 170, 88)
    ui.field("FadeTime", "Brightness~Fade Time", 456, 168, 64, 24, { HTextAlign = "Center" })

    -- Color (fader colors are content colors)
    ui.section("Color", 8, 232, 624, 200)
    local rows = { { "Hue", "Hue", { 230, 80, 200 } }, { "Saturation", "Saturation", { 64, 140, 230 } },
                   { "Red", "Red", { 214, 69, 65 } }, { "Green", "Green", { 60, 200, 80 } }, { "Blue", "Blue", { 60, 110, 240 } } }
    for i, r in ipairs(rows) do
      local y = 264 + (i - 1) * 32
      lbl(r[2], 16, y + 2, 76)
      ui.fader(r[1], "Color~" .. r[2], 100, y, 300, 24, r[3])
    end
    ui.led("ColorSwatch", "Color~Swatch", 424, 272, 112, { 255, 255, 255 }, { Margin = 0 })
    lbl("HEX", 552, 264, 64, "Left")
    ui.field("HexColor", "Color~Hex", 552, 284, 72, 24, { HTextAlign = "Center" })
    lbl("MODE", 552, 320, 64, "Left")
    ui.readout("ColorMode", "Color~Mode", 552, 340, 72, 24, { HTextAlign = "Center" })

    -- White (kelvin fader keeps its warm content color)
    ui.section("White (Color Temperature)", 8, 440, 624, 104)
    lbl("Kelvin", 16, 474, 76)
    ui.fader("ColorTemp", "White~Color Temp", 100, 472, 300, 24, { 240, 165, 40 })
    note("1200 K - 6500 K (device limits apply)", 412, 476, 208)
    for i, wp in ipairs(WhitePresets) do
      ui.button("WhitePreset " .. i, wp[1], 100 + (i - 1) * 76, 504, 68, 28, "pad")
    end

    -- Quick colors (content colors)
    ui.section("Quick Colors", 8, 552, 624, 72)
    for i, qc in ipairs(QuickColors) do
      local c = qc[2]
      ui.button("QuickColor " .. i, qc[1], 20 + (i - 1) * 76, 584, 68, 28, "pad",
        { Color = c, OffColor = { math.floor(c[1] * 0.75), math.floor(c[2] * 0.75), math.floor(c[3] * 0.75) },
          TextColor = { 20, 20, 20 }, FontStyle = "Bold" })
    end
    ui.hint("Fade applies to brightness. Hue/Sat change color only; RGB and Hex also set brightness.", 632)

  elseif page == "Effects" then
    ui.page(544)
    hdr()
    ui.section("Scenes & Effects", 8, 64, 624, 104)
    lbl("Select", 16, 98, 76)
    ui.combo("EffectSelect", "Effects~Select", 100, 96, 324, 24)
    ui.button("EffectPrev", "< Prev", 432, 94, 60, 28, "secondary")
    ui.button("EffectNext", "Next >", 496, 94, 60, 28, "secondary")
    ui.button("EffectRefresh", "Refresh", 560, 94, 60, 28, "utility")
    lbl("Now Playing", 16, 130, 76)
    ui.readout("EffectCurrent", "Effects~Current", 100, 128, 324, 24, { FontStyle = "Bold" })
    ui.value("EffectCount", "Effects~Count", 432, 130, 188, 20, { TextColor = N.sub, FontSize = 11, HTextAlign = "Center" })

    ui.section("Effect Presets", 8, 176, 624, 232)
    for i = 1, EFFECT_BUTTONS do
      local c, r = (i - 1) % 4, math.floor((i - 1) / 4)
      ui.button("EffectButton " .. i, "", 20 + c * 152, 208 + r * 52, 144, 44, "pad", { ButtonStyle = "Toggle" })
    end
    ui.button("EffectPageDown", "< Page", 20, 368, 80, 28, "utility")
    ui.value("EffectPageLabel", "Effects~Page", 108, 372, 424, 20, { TextColor = N.sub, FontSize = 11, HTextAlign = "Center" })
    ui.button("EffectPageUp", "Page >", 540, 368, 80, 28, "utility")

    ui.section("Rhythm (sound reactive)", 8, 416, 624, 88)
    ui.led("RhythmConnected", "Rhythm~Connected", 24, 450, 16, "ok")
    lbl("Module / Mic Connected", 48, 448, 180, "Left")
    ui.led("RhythmActive", "Rhythm~Active", 24, 474, 16, "warn")
    lbl("Rhythm Effect Active", 48, 472, 180, "Left")
    lbl("Input", 296, 460, 64)
    ui.combo("RhythmMode", "Rhythm~Input", 368, 458, 168, 24)
    ui.hint("Pads play effects saved on the device. Rhythm input: Aurora Rhythm module only.", 512)

  elseif page == "Panels" then
    ui.page(440)
    hdr()
    ui.section("Layout", 8, 64, 624, 72)
    lbl("Panels", 16, 98, 64)
    ui.readout("PanelCount", "Panels~Count", 88, 96, 64, 24, { HTextAlign = "Center" })
    lbl("Orientation", 168, 98, 88)
    ui.field("Orientation", "Panels~Orientation", 264, 96, 64, 24, { HTextAlign = "Center" })
    note("deg", 334, 100, 32)
    ui.button("Identify", "Identify (Flash)", 480, 92, 140, 32, "warn")

    ui.section("Individual Panel Color", 8, 144, 624, 256)
    lbl("Panel", 16, 178, 64)
    ui.combo("PanelSelect", "Panels~Select", 88, 176, 224, 24)
    ui.value("PanelInfo", "Panels~Info", 320, 178, 300, 20, { TextColor = N.sub, FontSize = 11 })
    local prow = { { "PanelRed", "Red", { 214, 69, 65 } }, { "PanelGreen", "Green", { 60, 200, 80 } }, { "PanelBlue", "Blue", { 60, 110, 240 } } }
    for i, r in ipairs(prow) do
      local y = 216 + (i - 1) * 32
      lbl(r[2], 16, y + 2, 64)
      ui.fader(r[1], "Panels~" .. r[2], 88, y, 304, 24, r[3])
    end
    ui.led("PanelSwatch", "Panels~Swatch", 424, 208, 96, { 255, 255, 255 }, { Margin = 0 })
    lbl("Transition (s)", 16, 314, 96)
    ui.field("PanelTransition", "Panels~Transition", 120, 312, 64, 24, { HTextAlign = "Center" })
    ui.button("PanelApply", "Apply to Panel", 88, 352, 180, 32, "secondary", { FontStyle = "Bold" })
    ui.button("PanelApplyAll", "Apply to All Panels", 280, 352, 180, 32, "secondary")
    ui.hint("Orientation rotates effect mapping. Panel colors are a static effect; any scene clears them.", 408)

  elseif page == "Setup" then
    ui.page(392)
    hdr()
    ui.section("Connection", 8, 64, 624, 128)
    lbl("IP Address", 16, 98, 96)
    ui.field("IPAddress", "Setup~IP Address", 120, 96, 208, 24)
    ui.button("Connect", "Connect / Refresh", 336, 94, 152, 28, "secondary")
    ui.button("Pair", "Pair", 496, 94, 124, 28, "ok")
    lbl("Auth Token", 16, 130, 96)
    ui.field("AuthToken", "Setup~Auth Token", 120, 128, 368, 24, { FontSize = 11 })
    ui.button("Unpair", "Unpair", 496, 126, 124, 28, "danger")
    lbl("Last Error", 16, 162, 96)
    ui.readout("LastError", "Setup~Last Error", 120, 160, 500, 24, { TextColor = S.warn })

    ui.section("Device Information", 8, 200, 624, 152)
    local info = { { "Model", "Model" }, { "SerialNumber", "Serial Number" }, { "Firmware", "Firmware" }, { "Manufacturer", "Manufacturer" } }
    for i, f in ipairs(info) do
      local y = 232 + (i - 1) * 28
      lbl(f[2], 16, y + 2, 96)
      ui.readout(f[1], "Setup~" .. f[2], 120, y, 300, 24)
    end
    note("Port and poll interval are", 436, 236, 184)
    note("set in the plugin Properties.", 436, 252, 184)
    ui.hint("To pair, hold the power button 5-7 s until the LEDs flash, then press Pair within 30 s.", 360)
  end

  return layout, graphics
end

--=====================================================================
-- Runtime
--=====================================================================
if Controls then
  local rapidjson = require("rapidjson")

  local PORT = Properties["Port"].Value
  local POLL = Properties["Poll Interval (s)"].Value
  local DEBUG = Properties["Debug Print"].Value

  local function dbg(level, ...)
    if DEBUG == "All" or (DEBUG == "Errors" and level == "err") then print(...) end
  end

  -- state ------------------------------------------------------------
  local effects = {}          -- effect names from the device
  local effectPage = 1
  local currentEffect = ""
  local panels = {}           -- { id=, x=, y=, o=, shape=, r=, g=, b= }
  local devState = {}         -- last state table from the device
  local failCount = 0
  local userTouch = {}        -- control group -> os.clock() of last user change
  local HOLD = 2.0            -- seconds poll feedback is ignored after a user change

  local NON_LIT = { [1] = true, [12] = true, [16] = true, [19] = true, [20] = true }
  local SHAPE_NAMES = {
    [0] = "Light Panel Triangle", [1] = "Rhythm Module", [2] = "Canvas Square", [3] = "Canvas Control Square",
    [4] = "Canvas Square", [7] = "Shapes Hexagon", [8] = "Shapes Triangle", [9] = "Shapes Mini Triangle",
    [12] = "Shapes Controller", [14] = "Elements Hexagon", [15] = "Elements Hex Corner", [16] = "Lines Connector",
    [17] = "Light Line", [18] = "Light Line (single zone)", [19] = "Controller Cap", [20] = "Power Connector",
  }

  -- helpers ----------------------------------------------------------
  local function clamp(v, lo, hi) return math.max(lo, math.min(hi, v)) end
  local function round(v) return math.floor(v + 0.5) end
  local function touched(group) return userTouch[group] and (os.clock() - userTouch[group]) < HOLD end
  local function touch(group) userTouch[group] = os.clock() end

  local function rgbToHsv(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local mx, mn = math.max(r, g, b), math.min(r, g, b)
    local d = mx - mn
    local h = 0
    if d > 0 then
      if mx == r then h = ((g - b) / d) % 6
      elseif mx == g then h = (b - r) / d + 2
      else h = (r - g) / d + 4 end
      h = h * 60
    end
    local s = (mx == 0) and 0 or d / mx
    return round(h) % 360, round(s * 100), round(mx * 100)
  end

  local function hsvToRgb(h, s, v)
    s, v = s / 100, v / 100
    local c = v * s
    local x = c * (1 - math.abs((h / 60) % 2 - 1))
    local m = v - c
    local r, g, b
    if h < 60 then r, g, b = c, x, 0
    elseif h < 120 then r, g, b = x, c, 0
    elseif h < 180 then r, g, b = 0, c, x
    elseif h < 240 then r, g, b = 0, x, c
    elseif h < 300 then r, g, b = x, 0, c
    else r, g, b = c, 0, x end
    return round((r + m) * 255), round((g + m) * 255), round((b + m) * 255)
  end

  local function hex(r, g, b) return string.format("#%02X%02X%02X", r, g, b) end

  local function kelvinToRgb(k)
    -- approximation used only for the on-screen swatch
    local t = k / 100
    local r, g, b
    if t <= 66 then r = 255 else r = 329.698727446 * ((t - 60) ^ -0.1332047592) end
    if t <= 66 then g = 99.4708025861 * math.log(t) - 161.1195681661 else g = 288.1221695283 * ((t - 60) ^ -0.0755148492) end
    if t >= 66 then b = 255 elseif t <= 19 then b = 0 else b = 138.5177312231 * math.log(t - 10) - 305.0447927307 end
    return round(clamp(r, 0, 255)), round(clamp(g, 0, 255)), round(clamp(b, 0, 255))
  end

  local function setSwatch(r, g, b)
    Controls.ColorSwatch.Color = hex(r, g, b)
    Controls.ColorSwatch.Boolean = true
    Controls.HexColor.String = hex(r, g, b)
  end

  local function setStatus(code, msg)
    Controls.Status.Value = code
    Controls.Status.String = msg or ""
  end

  local function setError(msg)
    Controls.LastError.String = (msg or "") ~= "" and (os.date("%H:%M:%S ") .. msg) or ""
    if msg and msg ~= "" then dbg("err", "Nanoleaf: " .. msg) end
  end

  local function baseUrl(withToken)
    local ip = Controls.IPAddress.String:gsub("%s", "")
    local url = string.format("http://%s:%d/api/v1", ip, PORT)
    if withToken then url = url .. "/" .. Controls.AuthToken.String:gsub("%s", "") end
    return url
  end

  local function configured()
    return Controls.IPAddress.String:gsub("%s", "") ~= "" and Controls.AuthToken.String:gsub("%s", "") ~= ""
  end

  -- HTTP queue -------------------------------------------------------
  -- One request in flight at a time. Writes to the same endpoint are coalesced
  -- so dragging a fader only ever sends the latest value.
  local queue = {}     -- ordered list of { key, method, path, body }
  local busy = false
  local Poll           -- forward declaration

  local function sendNext()
    if busy or #queue == 0 then return end
    local job = table.remove(queue, 1)
    busy = true
    local url = (job.noToken and baseUrl(false) or baseUrl(true)) .. (job.path or "")
    local data = job.body and rapidjson.encode(job.body) or ""
    dbg("all", job.method .. " " .. url .. " " .. data)
    local function done(tbl, code, resp, err, headers)
      busy = false
      if job.callback then job.callback(code, resp, err) end
      if code == 401 then
        setStatus(2, "Unauthorized - pair again")
        setError("401 Unauthorized: auth token is not valid")
      elseif code ~= nil and code >= 400 and job.method ~= "GET" and not job.callback then
        setError(string.format("%s %s returned HTTP %d", job.method, job.path or "/", code))
      end
      sendNext()
    end
    if job.method == "GET" then
      HttpClient.Download { Url = url, Timeout = 4, EventHandler = done }
    elseif job.method == "DELETE" and HttpClient.Delete then
      HttpClient.Delete { Url = url, Timeout = 4, EventHandler = done }
    else
      HttpClient.Upload { Url = url, Method = job.method, Data = data, Timeout = 4,
        Headers = { ["Content-Type"] = "application/json" }, EventHandler = done }
    end
  end

  local function enqueue(job)
    if job.key then
      for _, q in ipairs(queue) do
        if q.key == job.key then
          -- merge state bodies (e.g. hue + sat), replace everything else
          if job.merge and q.body then
            for k, v in pairs(job.body) do q.body[k] = v end
          else
            q.body = job.body
          end
          return
        end
      end
    end
    table.insert(queue, job)
    sendNext()
  end

  local function putState(body)
    if not configured() then setError("Set the IP address and auth token on the Setup page"); return end
    enqueue({ key = "state", method = "PUT", path = "/state", body = body, merge = true })
  end

  local function putEffects(body, key)
    if not configured() then setError("Set the IP address and auth token on the Setup page"); return end
    enqueue({ key = key or "effects", method = "PUT", path = "/effects", body = body })
  end

  -- feedback ---------------------------------------------------------
  local function updateEffectButtons()
    local pages = math.max(1, math.ceil(#effects / EFFECT_BUTTONS))
    effectPage = clamp(effectPage, 1, pages)
    local offset = (effectPage - 1) * EFFECT_BUTTONS
    for i = 1, EFFECT_BUTTONS do
      local name = effects[offset + i]
      local b = Controls.EffectButton[i]
      b.Legend = name or ""
      b.IsDisabled = (name == nil)
      b.Boolean = (name ~= nil and name == currentEffect)
    end
    if #effects == 0 then
      Controls.EffectPageLabel.String = "No effects loaded"
    else
      Controls.EffectPageLabel.String = string.format("Page %d of %d  (%d-%d of %d)", effectPage, pages,
        offset + 1, math.min(offset + EFFECT_BUTTONS, #effects), #effects)
    end
  end

  local function prettyEffect(name)
    if name == "*Solid*" then return "Solid Color"
    elseif name == "*Static*" then return "Static (per-panel)"
    elseif name == "*Dynamic*" then return "Dynamic"
    elseif name == "*ExtControl*" then return "External Control" end
    return name or ""
  end

  local function setEffectList(list)
    local changed = #list ~= #effects
    if not changed then
      for i, v in ipairs(list) do if effects[i] ~= v then changed = true break end end
    end
    if changed then
      effects = list
      Controls.EffectSelect.Choices = effects
      updateEffectButtons()
    end
    Controls.EffectCount.String = string.format("%d effects on device", #effects)
  end

  local function setCurrentEffect(name)
    currentEffect = name or ""
    Controls.EffectCurrent.String = prettyEffect(currentEffect)
    if not touched("effect") then
      Controls.EffectSelect.String = currentEffect:sub(1, 1) == "*" and "" or currentEffect
    end
    updateEffectButtons()
  end

  local function updatePanelInfo()
    local sel = Controls.PanelSelect.String
    for _, p in ipairs(panels) do
      if p.label == sel then
        Controls.PanelInfo.String = string.format("%s  x=%d y=%d  rot=%d", SHAPE_NAMES[p.shape] or ("Shape " .. tostring(p.shape)), p.x, p.y, p.o)
        Controls.PanelRed.Value, Controls.PanelGreen.Value, Controls.PanelBlue.Value = p.r, p.g, p.b
        Controls.PanelSwatch.Color = hex(p.r, p.g, p.b)
        Controls.PanelSwatch.Boolean = true
        return p
      end
    end
    Controls.PanelInfo.String = ""
    return nil
  end

  local function setLayout(pl)
    if not pl then return end
    if pl.globalOrientation and pl.globalOrientation.value and not touched("orientation") then
      Controls.Orientation.Value = pl.globalOrientation.value
    end
    local layoutData = pl.layout or {}
    local pos = layoutData.positionData or {}
    local newPanels, changed = {}, (#pos ~= #panels)
    -- default per-panel color = current solid color
    local r, g, b = hsvToRgb(Controls.Hue.Value, Controls.Saturation.Value, 100)
    for i, p in ipairs(pos) do
      local old = panels[i]
      if not old or old.id ~= p.panelId then changed = true end
      table.insert(newPanels, {
        id = p.panelId, x = p.x or 0, y = p.y or 0, o = p.o or 0, shape = p.shapeType or 0,
        r = (old and old.id == p.panelId) and old.r or r,
        g = (old and old.id == p.panelId) and old.g or g,
        b = (old and old.id == p.panelId) and old.b or b,
        label = string.format("Panel %d  (ID %d)", i, p.panelId),
      })
    end
    if changed then
      panels = newPanels
      local choices, lit = {}, 0
      for _, p in ipairs(panels) do
        if not NON_LIT[p.shape] then table.insert(choices, p.label); lit = lit + 1 end
      end
      Controls.PanelSelect.Choices = choices
      if Controls.PanelSelect.String == "" and choices[1] then Controls.PanelSelect.String = choices[1] end
      Controls.PanelCount.String = tostring(lit)
      updatePanelInfo()
    end
  end

  local function setRhythm(rh)
    if type(rh) ~= "table" then
      Controls.RhythmConnected.Boolean = false
      Controls.RhythmActive.Boolean = false
      return
    end
    Controls.RhythmConnected.Boolean = rh.rhythmConnected == true
    Controls.RhythmActive.Boolean = rh.rhythmActive == true
    if rh.rhythmMode ~= nil and not touched("rhythm") then
      local m = type(rh.rhythmMode) == "table" and rh.rhythmMode.value or rh.rhythmMode
      Controls.RhythmMode.String = (m == 1) and "AUX In" or "Microphone"
    end
  end

  local function setState(st)
    devState = st
    if st.on and not touched("power") then Controls.Power.Boolean = st.on.value == true end
    if st.brightness and not touched("brightness") then Controls.Brightness.Value = st.brightness.value end
    if st.ct and not touched("ct") then Controls.ColorTemp.Value = st.ct.value end
    if not touched("color") then
      if st.hue then Controls.Hue.Value = st.hue.value end
      if st.sat then Controls.Saturation.Value = st.sat.value end
    end
    Controls.ColorMode.String = st.colorMode == "hs" and "Color" or st.colorMode == "ct" and "White"
      or st.colorMode == "effect" and "Effect" or (st.colorMode or "")
    -- swatch + RGB feedback
    if st.colorMode == "ct" then
      setSwatch(kelvinToRgb(Controls.ColorTemp.Value))
    elseif not touched("color") then
      local bri = (st.brightness and st.brightness.value) or 100
      local r, g, b = hsvToRgb(Controls.Hue.Value, Controls.Saturation.Value, bri)
      Controls.Red.Value, Controls.Green.Value, Controls.Blue.Value = r, g, b
      setSwatch(hsvToRgb(Controls.Hue.Value, Controls.Saturation.Value, 100))
    end
  end

  local function setOnline(ok, msg)
    Controls.Online.Boolean = ok
    if ok then
      failCount = 0
      setStatus(0, Controls.DeviceName.String)
    else
      failCount = failCount + 1
      if failCount >= 2 then setStatus(2, msg or "No response") end
    end
  end

  -- polling ----------------------------------------------------------
  Poll = function()
    if not configured() then
      if Controls.IPAddress.String == "" then setStatus(3, "Enter IP address")
      else setStatus(3, "Not paired - press Pair") end
      Controls.Online.Boolean = false
      return
    end
    -- skip if a GET is already queued
    for _, q in ipairs(queue) do if q.key == "poll" then return end end
    enqueue({ key = "poll", method = "GET", path = "/", callback = function(code, resp, err)
      if code == 200 and resp then
        local ok, info = pcall(rapidjson.decode, resp)
        if not ok or type(info) ~= "table" then setOnline(false, "Bad JSON from device"); return end
        Controls.DeviceName.String = info.name or ""
        Controls.Model.String = info.model or ""
        Controls.SerialNumber.String = info.serialNo or ""
        Controls.Firmware.String = info.firmwareVersion or ""
        Controls.Manufacturer.String = info.manufacturer or ""
        if info.state then setState(info.state) end
        if info.effects then
          setEffectList(info.effects.effectsList or {})
          setCurrentEffect(info.effects.select)
        end
        setLayout(info.panelLayout)
        setRhythm(info.rhythm)
        setOnline(true)
      elseif code == 401 then
        Controls.Online.Boolean = false
      else
        setOnline(false, (code == nil or code == 0) and "No response from device" or ("HTTP " .. tostring(code)))
      end
    end })
  end

  local pollTimer = Timer.New()
  pollTimer.EventHandler = Poll

  local function restart()
    queue = {}
    busy = false
    failCount = 0
    effects, panels = {}, {}
    pollTimer:Stop()
    setStatus(5, "Connecting")
    Poll()
    pollTimer:Start(POLL)
  end

  -- pairing ----------------------------------------------------------
  Controls.Pair.EventHandler = function()
    if Controls.IPAddress.String:gsub("%s", "") == "" then setError("Enter the IP address first"); return end
    setStatus(5, "Pairing...")
    enqueue({ method = "POST", path = "/new", noToken = true, callback = function(code, resp, err)
      if code == 200 and resp then
        local ok, t = pcall(rapidjson.decode, resp)
        if ok and t and t.auth_token then
          Controls.AuthToken.String = t.auth_token
          setError("")
          print("Nanoleaf: paired, auth token = " .. t.auth_token)
          restart()
          return
        end
      end
      if code == 403 then
        setError("Pairing refused (403): hold the power button 5-7 s until LEDs flash, then press Pair")
      else
        setError("Pairing failed: " .. (err and tostring(err) or ("HTTP " .. tostring(code))))
      end
      setStatus(2, "Pairing failed")
    end })
  end

  Controls.Unpair.EventHandler = function()
    if not configured() then return end
    enqueue({ method = "DELETE", path = "", callback = function(code)
      if code == 204 or code == 200 then
        Controls.AuthToken.String = ""
        setError("")
        setStatus(3, "Unpaired")
        Controls.Online.Boolean = false
      else
        setError("Unpair failed: HTTP " .. tostring(code))
      end
    end })
  end

  Controls.Connect.EventHandler = restart
  Controls.IPAddress.EventHandler = restart
  Controls.AuthToken.EventHandler = restart

  -- power ------------------------------------------------------------
  local function setPower(on)
    touch("power")
    Controls.Power.Boolean = on
    putState({ on = { value = on } })
  end
  Controls.Power.EventHandler = function(c) setPower(c.Boolean) end
  Controls.PowerOn.EventHandler = function() setPower(true) end
  Controls.PowerOff.EventHandler = function() setPower(false) end

  -- brightness -------------------------------------------------------
  local function fade() return round(Controls.FadeTime.Value) end
  Controls.Brightness.EventHandler = function(c)
    touch("brightness")
    local body = { brightness = { value = round(c.Value) } }
    if fade() > 0 then body.brightness.duration = fade() end
    putState(body)
  end
  local function stepBrightness(dir)
    touch("brightness")
    local step = round(Controls.BrightnessStep.Value) * dir
    Controls.Brightness.Value = clamp(Controls.Brightness.Value + step, 0, 100)
    putState({ brightness = { increment = step } })
  end
  Controls.BrightnessUp.EventHandler = function() stepBrightness(1) end
  Controls.BrightnessDown.EventHandler = function() stepBrightness(-1) end

  -- color ------------------------------------------------------------
  local function sendHueSat()
    touch("color")
    local h, s = round(Controls.Hue.Value), round(Controls.Saturation.Value)
    local r, g, b = hsvToRgb(h, s, Controls.Brightness.Value)
    Controls.Red.Value, Controls.Green.Value, Controls.Blue.Value = r, g, b
    setSwatch(hsvToRgb(h, s, 100))
    putState({ hue = { value = h }, sat = { value = s } })
  end
  Controls.Hue.EventHandler = sendHueSat
  Controls.Saturation.EventHandler = sendHueSat

  local function sendRgb(r, g, b)
    touch("color"); touch("brightness")
    local h, s, v = rgbToHsv(r, g, b)
    Controls.Hue.Value, Controls.Saturation.Value, Controls.Brightness.Value = h, s, v
    setSwatch(hsvToRgb(h, s, 100))
    local body = { hue = { value = h }, sat = { value = s }, brightness = { value = v } }
    if fade() > 0 then body.brightness.duration = fade() end
    putState(body)
  end
  local function rgbChanged()
    sendRgb(round(Controls.Red.Value), round(Controls.Green.Value), round(Controls.Blue.Value))
  end
  Controls.Red.EventHandler = rgbChanged
  Controls.Green.EventHandler = rgbChanged
  Controls.Blue.EventHandler = rgbChanged

  Controls.HexColor.EventHandler = function(c)
    local hx = c.String:gsub("#", ""):gsub("%s", "")
    if #hx == 6 and hx:match("^%x+$") then
      local r, g, b = tonumber(hx:sub(1, 2), 16), tonumber(hx:sub(3, 4), 16), tonumber(hx:sub(5, 6), 16)
      Controls.Red.Value, Controls.Green.Value, Controls.Blue.Value = r, g, b
      sendRgb(r, g, b)
    else
      setError("Hex color must look like #FF8800")
    end
  end

  for i, qc in ipairs(QuickColors) do
    Controls.QuickColor[i].EventHandler = function()
      local r, g, b = qc[2][1], qc[2][2], qc[2][3]
      -- quick colors keep the current brightness
      touch("color")
      local h, s = rgbToHsv(r, g, b)
      Controls.Hue.Value, Controls.Saturation.Value = h, s
      local rr, gg, bb = hsvToRgb(h, s, Controls.Brightness.Value)
      Controls.Red.Value, Controls.Green.Value, Controls.Blue.Value = rr, gg, bb
      setSwatch(hsvToRgb(h, s, 100))
      putState({ hue = { value = h }, sat = { value = s } })
    end
  end

  -- white ------------------------------------------------------------
  local function sendCt(k)
    touch("ct")
    local lo = (devState.ct and devState.ct.min) or 1200
    local hi = (devState.ct and devState.ct.max) or 6500
    k = clamp(round(k), lo, hi)
    Controls.ColorTemp.Value = k
    setSwatch(kelvinToRgb(k))
    putState({ ct = { value = k } })
  end
  Controls.ColorTemp.EventHandler = function(c) sendCt(c.Value) end
  for i, wp in ipairs(WhitePresets) do
    Controls.WhitePreset[i].EventHandler = function() sendCt(wp[2]) end
  end

  -- effects ----------------------------------------------------------
  local function selectEffect(name)
    if not name or name == "" then return end
    touch("effect")
    currentEffect = name
    Controls.EffectSelect.String = name
    Controls.EffectCurrent.String = prettyEffect(name)
    updateEffectButtons()
    putEffects({ select = name })
  end
  Controls.EffectSelect.EventHandler = function(c) selectEffect(c.String) end
  for i = 1, EFFECT_BUTTONS do
    Controls.EffectButton[i].EventHandler = function(c)
      local name = effects[(effectPage - 1) * EFFECT_BUTTONS + i]
      if name then selectEffect(name) else c.Boolean = false end
    end
  end
  local function stepEffect(dir)
    if #effects == 0 then return end
    local idx = 0
    for i, n in ipairs(effects) do if n == currentEffect then idx = i end end
    idx = ((idx - 1 + dir) % #effects) + 1
    effectPage = math.ceil(idx / EFFECT_BUTTONS)
    selectEffect(effects[idx])
  end
  Controls.EffectNext.EventHandler = function() stepEffect(1) end
  Controls.EffectPrev.EventHandler = function() stepEffect(-1) end
  Controls.EffectPageUp.EventHandler = function() effectPage = effectPage + 1; updateEffectButtons() end
  Controls.EffectPageDown.EventHandler = function() effectPage = effectPage - 1; updateEffectButtons() end
  Controls.EffectRefresh.EventHandler = function() effects = {}; Poll() end

  -- rhythm -----------------------------------------------------------
  Controls.RhythmMode.Choices = { "Microphone", "AUX In" }
  Controls.RhythmMode.EventHandler = function(c)
    touch("rhythm")
    if not configured() then return end
    enqueue({ key = "rhythm", method = "PUT", path = "/rhythm",
      body = { rhythmMode = { value = (c.String == "AUX In") and 1 or 0 } } })
  end

  -- panels -----------------------------------------------------------
  Controls.Orientation.EventHandler = function(c)
    touch("orientation")
    if not configured() then return end
    enqueue({ key = "orientation", method = "PUT", path = "/panelLayout",
      body = { globalOrientation = { value = round(c.Value) % 361 } } })
  end

  Controls.Identify.EventHandler = function()
    if not configured() then return end
    enqueue({ method = "PUT", path = "/identify", body = {} })
  end

  Controls.PanelSelect.EventHandler = updatePanelInfo

  local function panelSwatch()
    Controls.PanelSwatch.Color = hex(round(Controls.PanelRed.Value), round(Controls.PanelGreen.Value), round(Controls.PanelBlue.Value))
    Controls.PanelSwatch.Boolean = true
  end
  Controls.PanelRed.EventHandler = panelSwatch
  Controls.PanelGreen.EventHandler = panelSwatch
  Controls.PanelBlue.EventHandler = panelSwatch

  -- Static per-panel colors are written with the Open API "write" command,
  -- animType "static". animData = numPanels, then per panel:
  -- panelId numFrames R G B W transitionTime(1/10 s)
  local function writeStatic()
    local parts, n = {}, 0
    local t = round(Controls.PanelTransition.Value * 10)
    for _, p in ipairs(panels) do
      if not NON_LIT[p.shape] then
        n = n + 1
        table.insert(parts, string.format("%d 1 %d %d %d 0 %d", p.id, p.r, p.g, p.b, t))
      end
    end
    if n == 0 then setError("No panels found - check the connection"); return end
    putEffects({ write = { command = "display", animType = "static", animData = n .. " " .. table.concat(parts, " "),
      loop = false, palette = rapidjson.array and rapidjson.array({}) or nil } }, "static")
    currentEffect = "*Static*"
    Controls.EffectCurrent.String = prettyEffect(currentEffect)
    updateEffectButtons()
  end

  Controls.PanelApply.EventHandler = function()
    local sel = Controls.PanelSelect.String
    for _, p in ipairs(panels) do
      if p.label == sel then
        p.r, p.g, p.b = round(Controls.PanelRed.Value), round(Controls.PanelGreen.Value), round(Controls.PanelBlue.Value)
        writeStatic()
        return
      end
    end
    setError("Select a panel first")
  end

  Controls.PanelApplyAll.EventHandler = function()
    local r, g, b = round(Controls.PanelRed.Value), round(Controls.PanelGreen.Value), round(Controls.PanelBlue.Value)
    for _, p in ipairs(panels) do p.r, p.g, p.b = r, g, b end
    writeStatic()
  end

  -- startup ----------------------------------------------------------
  Controls.ColorSwatch.Boolean = true
  Controls.PanelSwatch.Boolean = true
  panelSwatch()
  updateEffectButtons()
  setError("")
  restart()
end
