--[[ Hermes Agent plugin for Q-SYS
  Sends prompts to a Hermes Agent (Nous Research) running on a local machine and
  shows its answers. Talks to the agent's built-in API server over HTTP
  (default port 8642), using the Runs API so long agent turns can be followed,
  stopped, steered and approved from Q-SYS.

  Endpoints used (all under http://<host>:<port>[/p/<profile>]):
    GET  /health                          liveness (no key)
    GET  /v1/models                       key check and the agent's advertised name
    GET  /v1/capabilities                 which features this Hermes version has
    POST /v1/runs                         start a turn: input, session_id, instructions, model, provider
    GET  /v1/runs/{run_id}                poll status, output, usage, runtime, pending approvals
    POST /v1/runs/{run_id}/stop           interrupt the turn
    POST /v1/runs/{run_id}/steer          add guidance to a running turn
    POST /v1/runs/{run_id}/approval       answer a pending tool approval
    POST /v1/runs/{run_id}/clarify        answer a clarifying question
    POST /v1/runs/{run_id}/resolve-unknown acknowledge a turn lost to a gateway restart
  Every request except /health sends "Authorization: Bearer <API_SERVER_KEY>".

  References:
    Hermes Agent API Server         - https://hermes-agent.nousresearch.com/docs/user-guide/features/api-server
    Hermes Agent programmatic use   - https://hermes-agent.nousresearch.com/docs/developer-guide/programmatic-integration
    Hermes Agent source (API server)- https://github.com/NousResearch/hermes-agent (gateway/platforms/api_server_runs.py)
    Q-SYS HttpClient                - https://help.qsys.com/Content/Control_Scripting/Using_Lua_in_Q-Sys/HttpClient.htm
]]

PluginInfo = {
  Name = "AI~Hermes Agent",
  Version = "1.0",
  BuildVersion = "1.0.0.0",
  Id = "06fb33e1-acc1-4f43-a296-2977085feb64",
  Author = "AV Programming",
  Description = "Send prompts to a locally running Hermes Agent (Nous Research) and show its answers, over the agent's API server (Runs API): conversation, stop, steer, tool approvals, preset prompts.",
  ShowDebug = true,
}

local ACCENT = { 120, 92, 200 }  -- schematic block color only; pages use the shared theme

--[[ Deep Ocean theme for Q-SYS plugins, v2.0 (2026-10-15)
     The home-dash design system (thomas-nelson23/home-dashboard, web/src/styles.css + theme.css)
     translated into what GetControlLayout can draw. Paste this block into a .qplug above
     GetControlLayout, then:

       function GetControlLayout(props)
         local layout, graphics = {}, {}
         local ui = Theme.kit(layout, graphics)
         ui.page(600)
         ui.header("PHILIPS|HUE", "Control", "BridgeName", "Status", "Online", 1)
         ui.section("Power", 8, 64, 200, 160)
         ui.button("Power", "POWER", 24, 96, 168, 48, "power")
         ...
         ui.hint("Pick a room, then use the pads.", 568)
         return layout, graphics
       end

     Every property used here is a documented GetControlLayout property:
     https://help.qsys.com/DeveloperHelp/Content/Standards_Definitions/Reserved_Functions.htm
     Guide: design/README.md in thomas-nelson23/qsys-plugins.
]]
local Theme = {}

Theme.W = 640   -- page width; every page is 640 wide
Theme.GRID = 8  -- positions and sizes snap to 8 (4 for fine alignment inside a row)

-- home-dash tokens. Glass and hairline colors are pre-blended over the panel or the
-- field, because Q-SYS draws solid fills (comments give the CSS each one comes from).
Theme.N = {
  bg      = { 2, 29, 46 },     -- --field #021d2e: the one flat deep-blue field
  panel   = { 6, 18, 27 },     -- .panel/.tile: rgba(--ink 4,12,18, .62-.93) glass over the field
  strip   = { 8, 27, 37 },     -- --surface-hi rgba(cyan, .045): a tile or row inside a panel
  rowAlt  = { 12, 24, 33 },    -- rgba(255,255,255,.025): alternate list row
  well    = { 4, 13, 19 },     -- .field input rgba(0,0,0,.3): readouts, fields, meters, hint bar
  stroke  = { 25, 41, 50 },    -- --glass-edge rgba(200,245,255,.1): panel and input edges
  hair    = { 20, 31, 40 },    -- --hair rgba(255,255,255,.055): dividers
  line    = { 10, 37, 50 },    -- --line rgba(cyan,.1)
  lineStrong = { 16, 72, 91 }, -- --line-strong rgba(cyan,.28): button and field outlines
  btn     = { 12, 24, 33 },    -- .btn background rgba(255,255,255,.025)
  btnOn   = { 25, 41, 50 },    -- .btn:hover, lifted
  ledOff  = { 0, 0, 0, 0 },    -- .led-off: hollow, only the ring shows
  white   = { 255, 255, 255 }, -- headings and big values (#fff)
  text    = { 217, 238, 242 }, -- --text #d9eef2
  sub     = { 156, 199, 207 }, -- --text-soft #9cc7cf: labels, secondary values
  dim     = { 95, 114, 122 },  -- --text-dim #5f727a: section titles, notes, units
  off     = { 58, 70, 80 },    -- --off #3a4650
  ink     = { 11, 15, 28 },    -- #0b0f1c: text on a solid cyan or white fill
}

-- Semantic colors: same meaning in every plugin. Cyan is also the only accent.
Theme.S = {
  ok    = { 42, 212, 255 },  -- --cyan #2ad4ff (Deep Ocean): good, online, on, the accent
  warn  = { 255, 176, 32 },  -- --warn #ffb020: attention only, always with a label
  fault = { 255, 42, 79 },   -- --red #ff2a4f: bad/offline, destructive actions, small signals
}

function Theme.mix(a, b, t)  -- t = 0 gives a, t = 1 gives b
  return { math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
           math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
           math.floor(a[3] + (b[3] - a[3]) * t + 0.5) }
end

-- home-dash has one accent, cyan. Theme.brand keeps the v1 field names so plugin code that
-- reads ui.B still works; the accent argument is accepted and ignored.
function Theme.brand()
  local cyan, panel = Theme.S.ok, Theme.N.panel
  return {
    accent = cyan,                        -- fader/knob/meter fill, on state of solid controls
    on     = Theme.mix(panel, cyan, 0.45), -- lit button fill (cyan at 45% over the panel)
    soft   = Theme.mix(panel, cyan, 0.08), -- --cyan-soft: .btn-accent and pad off state
    edge   = Theme.mix(panel, cyan, 0.45), -- rgba(cyan,.45): .btn-accent border
    dim    = Theme.mix(panel, cyan, 0.08), -- v1 name for soft
    pad    = Theme.mix(panel, cyan, 0.08), -- v1 name for soft
    ink    = cyan,                        -- cyan text (.lcd-inline, .bar-rest)
  }
end

-- Fonts. Q-SYS ships a fixed font list; these are the closest stand-ins for home-dash's
-- Sora (text), JetBrains Mono (numbers, ids) and Michroma (wordmark, display).
local FONT, MONO, DISPLAY = "Poppins", "Roboto Mono", "Montserrat"

local CUBE_SVG = "PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9Ii0xMDAgLTEwMCAyMDAgMjAwIj48ZyBm"
  .. "aWxsPSJub25lIiBzdHJva2U9IiMyYWQ0ZmYiIHN0cm9rZS13aWR0aD0iNy4wIiBzdHJva2UtbGluZWNhcD0icm91bmQiPjxw"
  .. "YXRoIHN0cm9rZS1vcGFjaXR5PSIwLjE3NiIgZD0iTS0wLjAsODAuM0wtNzAuNyw0Mi4xTS0wLjAsODAuM0w3MC43LDQyLjFN"
  .. "MjMuNiw2Ny41TC00Ny4xLDI5LjNNLTIzLjYsNjcuNUw0Ny4xLDI5LjNNNDcuMSw1NC44TC0yMy42LDE2LjZNLTQ3LjEsNTQu"
  .. "OEwyMy42LDE2LjZNNzAuNyw0Mi4xTDAuMCwzLjlNLTcwLjcsNDIuMUwwLjAsMy45TTcwLjcsNDIuMUw3MC43LC00Mi4xTTcw"
  .. "LjcsNDIuMUwwLjAsMy45TTQ3LjEsMjkuM0w0Ny4xLC01NC44TTcwLjcsMTQuMEwwLjAsLTI0LjJNMjMuNiwxNi42TDIzLjYs"
  .. "LTY3LjVNNzAuNywtMTQuMEwwLjAsLTUyLjJNMC4wLDMuOUwwLjAsLTgwLjNNNzAuNywtNDIuMUwwLjAsLTgwLjNNLTcwLjcs"
  .. "NDIuMUwtNzAuNywtNDIuMU0tNzAuNyw0Mi4xTDAuMCwzLjlNLTQ3LjEsMjkuM0wtNDcuMSwtNTQuOE0tNzAuNywxNC4wTDAu"
  .. "MCwtMjQuMk0tMjMuNiwxNi42TC0yMy42LC02Ny41TS03MC43LC0xNC4wTDAuMCwtNTIuMk0wLjAsMy45TDAuMCwtODAuM00t"
  .. "NzAuNywtNDIuMUwwLjAsLTgwLjMiLz48cGF0aCBzdHJva2Utb3BhY2l0eT0iMC44IiBkPSJNLTAuMCwtMy45TC03MC43LC00"
  .. "Mi4xTS0wLjAsLTMuOUw3MC43LC00Mi4xTTIzLjYsLTE2LjZMLTQ3LjEsLTU0LjhNLTIzLjYsLTE2LjZMNDcuMSwtNTQuOE00"
  .. "Ny4xLC0yOS4zTC0yMy42LC02Ny41TS00Ny4xLC0yOS4zTDIzLjYsLTY3LjVNNzAuNywtNDIuMUwwLjAsLTgwLjNNLTcwLjcs"
  .. "LTQyLjFMMC4wLC04MC4zTS0wLjAsODAuM0wtMC4wLC0zLjlNLTAuMCw4MC4zTC03MC43LDQyLjFNLTIzLjYsNjcuNUwtMjMu"
  .. "NiwtMTYuNk0tMC4wLDUyLjJMLTcwLjcsMTQuME0tNDcuMSw1NC44TC00Ny4xLC0yOS4zTS0wLjAsMjQuMkwtNzAuNywtMTQu"
  .. "ME0tNzAuNyw0Mi4xTC03MC43LC00Mi4xTS0wLjAsLTMuOUwtNzAuNywtNDIuMU0tMC4wLDgwLjNMLTAuMCwtMy45TS0wLjAs"
  .. "ODAuM0w3MC43LDQyLjFNMjMuNiw2Ny41TDIzLjYsLTE2LjZNLTAuMCw1Mi4yTDcwLjcsMTQuME00Ny4xLDU0LjhMNDcuMSwt"
  .. "MjkuM00tMC4wLDI0LjJMNzAuNywtMTQuME03MC43LDQyLjFMNzAuNywtNDIuMU0tMC4wLC0zLjlMNzAuNywtNDIuMSIvPjwv"
  .. "Zz48L3N2Zz4="

local function merge(t, extra)
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

function Theme.kit(layout, graphics)
  local N, S, B = Theme.N, Theme.S, Theme.brand()
  local ui = { N = N, S = S, B = B }

  local function g(t) table.insert(graphics, t) end
  local function box(x, y, w, h, fill, stroke, radius)
    g({ Type = "GroupBox", Fill = fill, StrokeColor = stroke or fill, StrokeWidth = stroke and 1 or 0,
        CornerRadius = radius or 0, Position = { x, y }, Size = { w, h } })
  end

  -- Static text. size: 10 hint/title, 11 label, 12 body, 13 emphasis
  function ui.label(text, x, y, w, h, align, size, color, style)
    g({ Type = "Label", Text = text, Font = FONT, FontStyle = style or "Regular", FontSize = size or 11,
        HTextAlign = align or "Right", Color = color or N.sub, Position = { x, y }, Size = { w, h or 20 } })
  end

  -- Page background: one flat field, no glows. Call first so it sits behind everything.
  function ui.page(h)
    box(0, 0, Theme.W, h, N.bg)
  end

  -- The wireframe cube from home-dash's backdrop, frozen at its starting pose
  -- (the frame home-dash shows when motion is reduced). s = size in px.
  function ui.cube(x, y, s)
    g({ Type = "Svg", Image = CUBE_SVG, Position = { x, y }, Size = { s, s } })
  end
  ui.sun = ui.cube  -- v1 name

  -- The front window's top edge: transparent > cyan > red > transparent, in 24 px steps.
  function ui.edge(x, y, w, base)
    local n = math.floor(w / 24)
    for i = 0, n - 1 do
      local t = (i + 0.5) / n
      local c
      if t < 0.25 then c = Theme.mix(base, S.ok, t / 0.25)
      elseif t < 0.75 then c = Theme.mix(S.ok, S.fault, (t - 0.25) / 0.5)
      else c = Theme.mix(S.fault, base, (t - 0.75) / 0.25) end
      box(x + i * 24, y, (i == n - 1) and (w - i * 24) or 24, 1, c)
    end
  end

  -- Top bar: cube, wordmark (Michroma stand-in; text after "|" is red, like "home|dash"),
  -- page number (red, mono) and page name like the numbered menu, device name, Status, Online LED.
  function ui.header(wordmark, pageName, nameCtl, statusCtl, ledCtl, pageNo)
    box(8, 8, 624, 48, N.panel, N.stroke, 8)
    ui.edge(16, 8, 608, N.stroke)
    ui.cube(18, 16, 32)
    local a, b = wordmark:match("^(.-)|(.*)$")
    a, b = string.upper(a or wordmark), string.upper(b or "")
    -- Q-SYS can't measure text, so the white part is right-aligned and the red part
    -- left-aligned on one seam; only the seam position is estimated (caps ~8.5 px at 13 px).
    local seam = 58 + math.floor(#a * 8.5 + 0.5)
    g({ Type = "Label", Text = a, Font = DISPLAY, FontStyle = "Medium", FontSize = 13, HTextAlign = "Right",
        Color = N.white, Position = { seam - 104, 20 }, Size = { 104, 24 }, Padding = 0 })
    if b ~= "" then
      g({ Type = "Label", Text = b, Font = DISPLAY, FontStyle = "Medium", FontSize = 13, HTextAlign = "Left",
          Color = S.fault, Position = { seam, 20 }, Size = { 104, 24 }, Padding = 0 })
    end
    if pageNo then
      g({ Type = "Label", Text = string.format("%02d", pageNo), Font = MONO, FontSize = 10, HTextAlign = "Left",
          Color = S.fault, Position = { 160, 22 }, Size = { 20, 20 } })
    end
    g({ Type = "Label", Text = string.upper(pageName), Font = FONT, FontStyle = "Medium", FontSize = 10,
        HTextAlign = "Left", Color = N.white, Position = { 180, 22 }, Size = { 96, 20 } })
    if nameCtl then ui.value(nameCtl, nil, 280, 20, 164, 24, { Color = N.panel, TextColor = N.sub, FontSize = 12 }) end
    if statusCtl then
      layout[statusCtl] = { PrettyName = "Status", Style = "Text", Position = { 452, 20 }, Size = { 140, 24 },
        Font = FONT, FontSize = 11, CornerRadius = 12 }
    end
    if ledCtl then ui.led(ledCtl, "Online", 602, 24, 16, "ok") end
  end

  -- Panel: glass card with a hairline edge, a small red signal, an uppercase dim title
  -- and a hairline under the title. Content starts 32 px below y.
  function ui.section(title, x, y, w, h)
    box(x, y, w, h, N.panel, N.stroke, 8)
    if title and title ~= "" then
      g({ Type = "GroupBox", StrokeColor = S.fault, StrokeWidth = 1, CornerRadius = 4,
          Position = { x + 12, y + 10 }, Size = { 8, 8 } })
      ui.label(string.upper(title), x + 26, y + 4, w - 38, 20, "Left", 10, N.dim, "SemiBold")
      box(x + 1, y + 27, w - 2, 1, N.hair)
    end
  end

  -- Tile inside a panel.
  function ui.strip(x, y, w, h)
    box(x, y, w, h, N.strip, N.hair, 8)
  end

  -- List row: every other row gets the faint lift.
  function ui.row(x, y, w, h, i)
    box(x, y, w, h, (i % 2 == 0) and N.rowAlt or N.strip, nil, 4)
  end

  -- Hint bar: one line of help per page, at the bottom.
  function ui.hint(text, y)
    g({ Type = "Label", Text = text, Font = FONT, FontSize = 10, HTextAlign = "Left", Color = N.dim, Fill = N.well,
        StrokeColor = N.hair, StrokeWidth = 1, CornerRadius = 8, Margin = 0, Padding = 8,
        Position = { 8, y }, Size = { 624, 24 } })
  end

  -- Buttons. kind (home-dash class in brackets):
  --   "primary"   toggle; dark pill, cyan when on            (.btn / .seg-btn.on)
  --   "secondary" cyan-tinted pill, cyan legend              (.btn-accent)
  --   "utility"   plain pill, soft legend                    (.btn)
  --   "pad"       preset tile, 8 px corners, cyan when on    (.tile-layouts button)
  --   "power"     the page's main action, bold               (.btn-accent, larger)
  --   "warn" / "danger" / "ok"  semantic tint and legend     (.banner-warn / .btn-danger)
  -- Pass ButtonStyle ("Toggle", "Momentary", "Trigger"...) in extra to match the control's ButtonType.
  local function tint(c, a) return Theme.mix(N.panel, c, a) end
  local KINDS = {
    primary   = { on = B.on, off = N.btn, text = N.text, stroke = N.lineStrong, pill = true, style = "SemiBold" },
    secondary = { on = B.on, off = B.soft, text = S.ok, stroke = B.edge, pill = true, style = "SemiBold" },
    utility   = { on = N.btnOn, off = N.btn, text = N.sub, stroke = N.lineStrong, pill = true, style = "SemiBold" },
    pad       = { on = B.on, off = N.strip, text = N.text, stroke = N.line, pill = false, style = "Medium" },
    power     = { on = B.on, off = N.btn, text = N.white, stroke = B.edge, pill = true, style = "Bold", size = 16 },
    warn      = { on = tint(S.warn, 0.25), off = tint(S.warn, 0.06), text = S.warn, stroke = tint(S.warn, 0.3), pill = true, style = "SemiBold" },
    danger    = { on = tint(S.fault, 0.25), off = tint(S.fault, 0.1), text = S.fault, stroke = tint(S.fault, 0.45), pill = true, style = "SemiBold" },
    ok        = { on = tint(S.ok, 0.25), off = B.soft, text = S.ok, stroke = B.edge, pill = true, style = "SemiBold" },
  }
  function ui.button(name, legend, x, y, w, h, kind, extra)
    local k = KINDS[kind or "primary"] or KINDS.primary
    h = h or 28
    layout[name] = merge({ PrettyName = name, Style = "Button", Legend = legend, Position = { x, y }, Size = { w, h },
      Color = k.on, OffColor = k.off, UnlinkOffColor = true, TextColor = k.text, StrokeColor = k.stroke, StrokeWidth = 1,
      Font = FONT, FontStyle = k.style, FontSize = k.size or 12,
      CornerRadius = k.pill and math.floor(math.min(w, h) / 2) or 8, ButtonVisualStyle = "Flat", Margin = 0, WordWrap = true }, extra)
  end

  -- Read-only readout: dark well, mono digits, no outline.
  function ui.readout(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h or 24 },
      Color = N.well, TextColor = N.text, Font = MONO, FontStyle = "Regular", FontSize = 12, HTextAlign = "Left",
      CornerRadius = 8, StrokeColor = N.well, StrokeWidth = 0, Padding = 4 }, extra)
  end

  -- Editable field: same well, plus the cyan-tinted outline so it reads as typeable.
  function ui.field(name, pretty, x, y, w, h, extra)
    ui.readout(name, pretty, x, y, w, h, merge({ StrokeColor = N.lineStrong, StrokeWidth = 1 }, extra))
  end

  -- Plain value text on the panel (names, secondary info). No well.
  function ui.value(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Text", Position = { x, y }, Size = { w, h or 20 },
      Color = N.panel, TextColor = N.text, Font = FONT, FontSize = 12, HTextAlign = "Left", StrokeWidth = 0,
      TextBoxStyle = "NoBackground" }, extra)
  end

  function ui.combo(name, pretty, x, y, w, h, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "ComboBox", Position = { x, y }, Size = { w, h or 24 },
      Color = N.well, TextColor = N.text, Font = FONT, FontSize = 12, StrokeColor = N.stroke, StrokeWidth = 1,
      CornerRadius = 8 }, extra)
  end

  -- Fader: horizontal when w > h, vertical when h > w. Cyan unless the color is the content.
  function ui.fader(name, pretty, x, y, w, h, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Fader", Position = { x, y }, Size = { w, h },
      Color = color or B.accent }, extra)
  end

  -- Knob: secondary parameters only (trim, fade time, step). 36 or 48 square.
  function ui.knob(name, pretty, x, y, s, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Knob", Position = { x, y }, Size = { s or 36, s or 36 },
      Color = color or B.accent }, extra)
  end

  -- Status dot. kind: "ok" | "warn" | "fault" | "accent" | an RGB table (e.g. a color swatch).
  -- Off is hollow: only the dim ring shows (.led-off).
  function ui.led(name, pretty, x, y, s, kind, extra)
    local c = type(kind) == "table" and kind or (kind == "accent" and B.accent) or S[kind or "ok"] or S.ok
    layout[name] = merge({ PrettyName = pretty or name, Style = "Led", Position = { x, y }, Size = { s or 16, s or 16 },
      Color = c, OffColor = N.ledOff, UnlinkOffColor = true, StrokeColor = N.dim, StrokeWidth = 1, Margin = 3 }, extra)
  end

  -- Meter: thin cyan bar on a faint track, no built-in text box (put a readout next to it).
  function ui.meter(name, pretty, x, y, w, h, color, extra)
    layout[name] = merge({ PrettyName = pretty or name, Style = "Meter", MeterStyle = "Standard", Position = { x, y },
      Size = { w, h }, Color = color or B.accent, BackgroundColor = Theme.mix(N.panel, N.white, 0.06), CornerRadius = 2,
      ShowTextbox = false, StrokeWidth = 0 }, extra)
  end

  -- Hide a control but keep its pins.
  function ui.hide(name, pretty)
    layout[name] = { PrettyName = pretty or name, Style = "None", Position = { 0, 0 }, Size = { 0, 0 } }
  end

  return ui
end

local TRANSCRIPT_ROWS = 16
local WRAP = 84          -- characters per transcript line (Roboto Mono 11 in a 564 px row)
local PRESETS = 8
local DEFAULT_PRESETS = {
  { "Status", "Give me a two-line status of this system." },
  { "Summary", "Summarize this conversation in three bullets." },
  { "Help", "What can you do from this room? Keep it short." },
  { "", "" }, { "", "" }, { "", "" }, { "", "" }, { "", "" },
}

function GetColor(props)
  return ACCENT
end

function GetPrettyName(props)
  return "Hermes Agent v" .. PluginInfo.Version
end

local PageNames = { "Chat", "Prompts", "Setup" }

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do table.insert(pages, { name = name }) end
  return pages
end

function GetProperties()
  return {
    { Name = "Port", Type = "integer", Min = 1, Max = 65535, Value = 8642 },
    { Name = "Use HTTPS", Type = "enum", Choices = { "No", "Yes" }, Value = "No" },
    { Name = "Health Poll (s)", Type = "integer", Min = 2, Max = 120, Value = 10 },
    { Name = "Max Turn Time (s)", Type = "integer", Min = 30, Max = 7200, Value = 900 },
    { Name = "Debug Print", Type = "enum", Choices = { "None", "Errors", "All" }, Value = "Errors" },
  }
end

function RectifyProperties(props)
  return props
end

function GetControls(props)
  local function ind(name, count, pin) return { Name = name, ControlType = "Indicator", IndicatorType = "Text", Count = count, PinStyle = pin or "Output", UserPin = (pin ~= "None") } end
  local function led(name) return { Name = name, ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output", UserPin = true } end
  local function trig(name, count) return { Name = name, ControlType = "Button", ButtonType = "Trigger", Count = count, PinStyle = "Input", UserPin = true } end
  local function text(name, count) return { Name = name, ControlType = "Text", Count = count, PinStyle = "Both", UserPin = true } end
  return {
    -- header
    { Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output", UserPin = true },
    led("Online"), ind("AgentName"),
    -- chat
    text("Prompt"), trig("Send"), trig("Stop"), trig("NewChat"),
    led("Busy"), ind("RunState"), ind("Elapsed"), ind("Response"),
    ind("Line", TRANSCRIPT_ROWS, "None"),
    { Name = "TranscriptScroll", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, DefaultValue = 100, PinStyle = "None", UserPin = false },
    trig("ScrollUp"), trig("ScrollDown"),
    -- approval
    led("ApprovalPending"), ind("ApprovalText"),
    trig("ApproveOnce"), trig("ApproveSession"), trig("Deny"),
    -- prompts
    text("PresetLabel", PRESETS), text("PresetPrompt", PRESETS), trig("PresetSend", PRESETS),
    text("Instructions"),
    -- setup
    text("Host"), text("ApiKey"), text("Profile"), text("Model"), text("Provider"), trig("Connect"),
    text("SessionId"),
    ind("LastError"), ind("AgentModel"), ind("Features"), ind("Health"),
    ind("LastRunId"), ind("LastRuntime"), ind("LastUsage"),
  }
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local page = PageNames[props["page_index"].Value]
  local ui = Theme.kit(layout, graphics)
  local N, S = ui.N, ui.S
  local MONO = "Roboto Mono"

  local function lbl(text, x, y, w, align) ui.label(text, x, y, w, 20, align or "Right", 11) end
  local function note(text, x, y, w) ui.label(text, x, y, w, 16, "Left", 10, N.dim) end
  local function hdr()
    ui.header("HERMES|AGENT", page, "AgentName", "Status", "Online", props["page_index"].Value)
    layout["AgentName"].PrettyName = "Agent Name"
  end

  if page == "Chat" then
    ui.page(736)
    hdr()
    ui.section("Conversation", 8, 64, 624, 400)
    ui.strip(16, 92, 580, 328)
    for i = 1, TRANSCRIPT_ROWS do
      ui.value("Line " .. i, "Conversation~Line " .. i, 24, 96 + (i - 1) * 20, 564, 20,
        { Font = MONO, FontSize = 11, Color = N.strip })
    end
    ui.button("ScrollUp", "^", 604, 92, 20, 20, "utility", { FontSize = 11 })
    ui.fader("TranscriptScroll", "Conversation~Scroll", 604, 116, 20, 280, nil, { ShowTextbox = false })
    ui.button("ScrollDown", "v", 604, 400, 20, 20, "utility", { FontSize = 11 })
    ui.led("Busy", "Conversation~Busy", 24, 432, 16, "ok")
    ui.value("RunState", "Conversation~State", 48, 428, 456, 24, { TextColor = N.sub, FontSize = 11 })
    ui.readout("Elapsed", "Conversation~Elapsed", 512, 428, 84, 24, { HTextAlign = "Center" })
    ui.hide("Response", "Conversation~Response")

    ui.section("Prompt", 8, 472, 624, 112)
    ui.field("Prompt", "Prompt~Text", 24, 504, 592, 32, { Font = "Poppins", FontSize = 12 })
    ui.button("Send", "SEND", 24, 544, 136, 28, "power", { FontSize = 13 })
    ui.button("Stop", "Stop", 168, 544, 96, 28, "danger")
    ui.button("NewChat", "New Chat", 272, 544, 112, 28, "utility")
    note("Send while Hermes is working adds", 400, 544, 216)
    note("guidance to the current turn.", 400, 558, 216)

    ui.section("Tool Approval", 8, 592, 624, 104)
    ui.led("ApprovalPending", "Approval~Pending", 24, 628, 16, "warn")
    ui.readout("ApprovalText", "Approval~Request", 48, 624, 568, 24, { TextColor = S.warn, FontSize = 11 })
    ui.button("ApproveOnce", "Approve Once", 48, 656, 144, 28, "ok")
    ui.button("ApproveSession", "Approve for Session", 200, 656, 168, 28, "secondary")
    ui.button("Deny", "Deny", 376, 656, 112, 28, "danger")
    ui.hint("Type a prompt and press SEND. Hermes may run tools first, so answers can take a while.", 704)

  elseif page == "Prompts" then
    ui.page(564)
    hdr()
    ui.section("Preset Prompts", 8, 64, 624, 348)
    note("BUTTON", 24, 94, 120)
    note("PROMPT", 152, 94, 352)
    for i = 1, PRESETS do
      local y = 116 + (i - 1) * 36
      ui.field("PresetLabel " .. i, "Presets~Label " .. i, 24, y, 120, 28, { Font = "Poppins", FontSize = 11 })
      ui.field("PresetPrompt " .. i, "Presets~Prompt " .. i, 152, y, 352, 28, { Font = "Poppins", FontSize = 11 })
      ui.button("PresetSend " .. i, "Preset " .. i, 512, y, 104, 28, "pad")
    end
    ui.section("Instructions", 8, 420, 624, 104)
    ui.field("Instructions", "Instructions~Text", 24, 452, 592, 32, { Font = "Poppins", FontSize = 11 })
    note("Optional. Added on top of Hermes' own system prompt for every turn sent from this plugin.", 24, 492, 592)
    ui.hint("A preset button sends its prompt into the current conversation. Its label becomes the legend.", 532)

  elseif page == "Setup" then
    ui.page(588)
    hdr()
    ui.section("Connection", 8, 64, 624, 200)
    lbl("Host", 16, 98, 96)
    ui.field("Host", "Setup~Host", 120, 96, 208, 24)
    lbl("Profile", 336, 98, 64)
    ui.field("Profile", "Setup~Profile", 408, 96, 208, 24)
    lbl("API Key", 16, 130, 96)
    ui.field("ApiKey", "Setup~API Key", 120, 128, 496, 24, { FontSize = 11 })
    lbl("Model", 16, 162, 96)
    ui.field("Model", "Setup~Model", 120, 160, 208, 24)
    lbl("Provider", 336, 162, 64)
    ui.field("Provider", "Setup~Provider", 408, 160, 208, 24)
    lbl("Last Error", 16, 194, 96)
    ui.readout("LastError", "Setup~Last Error", 120, 192, 496, 24, { TextColor = S.warn, FontSize = 11 })
    ui.button("Connect", "Connect / Refresh", 120, 226, 160, 28, "secondary")
    note("Leave Profile, Model and Provider blank to use", 296, 226, 320)
    note("the agent's defaults. Port and HTTPS are Properties.", 296, 240, 320)

    ui.section("Agent", 8, 272, 624, 148)
    local rows = { { "AgentModel", "Agent" }, { "Features", "Features" }, { "Health", "Health" } }
    for i, r in ipairs(rows) do
      local y = 304 + (i - 1) * 28
      lbl(r[2], 16, y + 2, 96)
      ui.readout(r[1], "Setup~" .. r[2], 120, y, 496, 24, { FontSize = 11 })
    end
    lbl("Session", 16, 390, 96)
    ui.field("SessionId", "Setup~Session ID", 120, 388, 496, 24, { FontSize = 11 })

    ui.section("Last Turn", 8, 428, 624, 120)
    local last = { { "LastRunId", "Run ID" }, { "LastRuntime", "Served By" }, { "LastUsage", "Tokens" } }
    for i, r in ipairs(last) do
      local y = 460 + (i - 1) * 28
      lbl(r[2], 16, y + 2, 96)
      ui.readout(r[1], "Setup~" .. r[2], 120, y, 496, 24, { FontSize = 11 })
    end
    ui.hint("Hermes binds to 127.0.0.1 by default. Set API_SERVER_HOST so the Core can reach it.", 556)
  end

  return layout, graphics
end

--=====================================================================
-- Runtime
--=====================================================================
if Controls then
  local rapidjson = require("rapidjson")

  local PORT = Properties["Port"].Value
  local SCHEME = (Properties["Use HTTPS"].Value == "Yes") and "https" or "http"
  local HEALTH_POLL = Properties["Health Poll (s)"].Value
  local MAX_TURN = Properties["Max Turn Time (s)"].Value
  local DEBUG = Properties["Debug Print"].Value
  local RUN_POLL = 1          -- seconds between run status polls while a turn is active
  local MAX_LINES = 400       -- transcript lines kept

  local function dbg(level, ...)
    if DEBUG == "All" or (DEBUG == "Errors" and level == "err") then print(...) end
  end

  -- state ------------------------------------------------------------
  local lines = {}            -- wrapped transcript lines
  local offset = 0            -- first transcript line shown
  local follow = true         -- keep the view on the newest line
  local run = nil             -- { id, started, approval, clarify, clarifyShown, stopping, lastEvent }
  local online = false
  local authOk = false
  local healthFails = 0
  local features = {}

  -- helpers ----------------------------------------------------------
  local function trim(s) return ((s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end
  local function round(v) return math.floor(v + 0.5) end
  local function str(v) return type(v) == "string" and v or "" end

  local function setStatus(code, msg)
    Controls.Status.Value = code
    Controls.Status.String = msg or ""
  end

  local function setError(msg)
    Controls.LastError.String = (msg or "") ~= "" and (os.date("%H:%M:%S ") .. msg) or ""
    if msg and msg ~= "" then dbg("err", "Hermes: " .. msg) end
  end

  local function host() return (trim(Controls.Host.String):gsub("^https?://", ""):gsub("/+$", "")) end
  local function apiKey() return trim(Controls.ApiKey.String) end

  local function baseUrl()
    local h = host()
    if not h:find(":%d+$") then h = h .. ":" .. PORT end
    local profile = trim(Controls.Profile.String)
    return SCHEME .. "://" .. h .. ((profile ~= "" and profile ~= "default") and ("/p/" .. profile) or "")
  end

  local function randomHex(n)
    local t = {}
    for i = 1, n do t[i] = string.format("%x", math.random(0, 15)) end
    return table.concat(t)
  end

  local function newSessionId()
    Controls.SessionId.String = "qsys_" .. os.date("%Y%m%d") .. "_" .. randomHex(8)
  end

  local function errorText(resp)
    local ok, t = pcall(rapidjson.decode, resp or "")
    if ok and type(t) == "table" then
      local e = t.error
      if type(e) == "table" then return str(e.message) ~= "" and e.message or str(e.code) end
      if type(e) == "string" then return e end
      if str(t.message) ~= "" then return t.message end
    end
    return ""
  end

  -- transcript -------------------------------------------------------
  -- Hermes answers are Markdown. The transcript is plain text, so emphasis marks and
  -- code fences are dropped, then each paragraph is wrapped to WRAP characters.
  local function plain(s)
    s = s:gsub("\r", ""):gsub("\t", "  ")
    s = s:gsub("\n```[^\n]*", "\n"):gsub("^```[^\n]*", "")
    s = s:gsub("%*%*", ""):gsub("__", ""):gsub("`", "")
    s = s:gsub("\n#+%s*", "\n"):gsub("^#+%s*", "")
    return s
  end

  local function chars(s)
    local t = {}
    for ch in s:gmatch("[%z\1-\127\194-\244][\128-\191]*") do t[#t + 1] = ch end
    return t
  end

  local function wrap(s, width, indent)
    local out = {}
    for para in (s .. "\n"):gmatch("(.-)\n") do
      local c = chars(para)
      if #c == 0 then out[#out + 1] = "" end
      local i = 1
      while i <= #c do
        local room = width - #indent
        local stop = math.min(#c, i + room - 1)
        if stop < #c then
          local j = stop
          while j > i and c[j + 1] ~= " " and c[j] ~= " " do j = j - 1 end
          if j > i then stop = j end
        end
        out[#out + 1] = indent .. table.concat(c, "", i, stop):gsub("%s+$", "")
        i = stop + 1
        while c[i] == " " do i = i + 1 end
      end
    end
    return out
  end

  local function scrollTo(ctl, off, total, rows)
    local maxOff = math.max(0, total - rows)
    off = math.max(0, math.min(maxOff, off))
    ctl.Value = (maxOff == 0) and 100 or (100 - off / maxOff * 100)
    return off
  end

  local function renderTranscript()
    if follow then offset = #lines end
    offset = scrollTo(Controls.TranscriptScroll, offset, #lines, TRANSCRIPT_ROWS)
    follow = offset >= math.max(0, #lines - TRANSCRIPT_ROWS)
    for i = 1, TRANSCRIPT_ROWS do
      Controls.Line[i].String = lines[offset + i] or ""
    end
  end

  local function add(text, prefix)
    local wrapped = wrap(plain(text), WRAP, "")
    if prefix then
      wrapped = wrap(plain(text), WRAP, "  ")
      wrapped[1] = prefix .. wrapped[1]:sub(3)
    end
    if #lines > 0 then lines[#lines + 1] = "" end
    for _, l in ipairs(wrapped) do lines[#lines + 1] = l end
    while #lines > MAX_LINES do table.remove(lines, 1) end
    follow = true
    renderTranscript()
  end

  local function clearTranscript()
    lines, offset, follow = {}, 0, true
    renderTranscript()
  end

  -- HTTP queue -------------------------------------------------------
  -- One request in flight at a time. Polls are dropped while another request is
  -- queued, so a slow agent machine never builds a backlog.
  local queue = {}
  local busy = false

  local function sendNext()
    if busy or #queue == 0 then return end
    local job = table.remove(queue, 1)
    busy = true
    local url = baseUrl() .. job.path
    local headers = { ["Accept"] = "application/json" }
    if not job.noAuth then headers["Authorization"] = "Bearer " .. apiKey() end
    for k, v in pairs(job.headers or {}) do headers[k] = v end
    local data = job.body and rapidjson.encode(job.body) or nil
    dbg("all", job.method .. " " .. url .. " " .. (data or ""))
    local function done(tbl, code, resp, err)
      busy = false
      dbg("all", "<- " .. tostring(code) .. " " .. tostring(resp and resp:sub(1, 300) or err))
      local ok, cbErr = pcall(job.callback, code, resp, err)
      if not ok then setError("Internal error: " .. tostring(cbErr)) end
      sendNext()
    end
    if job.method == "GET" then
      HttpClient.Download { Url = url, Headers = headers, Timeout = job.timeout or 5, EventHandler = done }
    else
      headers["Content-Type"] = "application/json"
      HttpClient.Upload { Url = url, Method = job.method, Data = data or "{}", Headers = headers,
        Timeout = job.timeout or 10, EventHandler = done }
    end
  end

  local function request(method, path, body, callback, opts)
    opts = opts or {}
    if opts.poll and (busy or #queue > 0) then return false end
    table.insert(queue, { method = method, path = path, body = body, callback = callback,
      timeout = opts.timeout, noAuth = opts.noAuth, headers = opts.headers })
    sendNext()
    return true
  end

  local function decode(resp)
    local ok, t = pcall(rapidjson.decode, resp or "")
    return (ok and type(t) == "table") and t or nil
  end

  -- status line ------------------------------------------------------
  local EVENT_TEXT = {
    ["tool.started"] = "using a tool", ["tool.completed"] = "tool finished",
    ["message.delta"] = "writing the answer", ["message.interim"] = "working",
    ["reasoning.delta"] = "thinking", ["subagent.start"] = "delegating to a subagent",
    ["subagent.complete"] = "subagent finished", ["approval.responded"] = "approval sent",
    ["run.stopping"] = "stopping",
  }

  local function renderHeader()
    if not online then
      Controls.Online.Boolean = false
      return
    end
    Controls.Online.Boolean = true
    if not authOk then return end
    if run then
      setStatus(0, run.approval and "Needs approval" or "Working")
    else
      setStatus(0, "Ready")
    end
  end

  local function renderRun()
    local active = run ~= nil
    Controls.Busy.Boolean = active
    Controls.Stop.IsDisabled = not active
    local ap = run and run.approval
    Controls.ApprovalPending.Boolean = ap ~= nil
    Controls.ApprovalText.String = ap and ap.text or ""
    Controls.ApproveOnce.IsDisabled = ap == nil
    Controls.Deny.IsDisabled = ap == nil
    Controls.ApproveSession.IsDisabled = not (ap and ap.choices.session)
    if active then
      local secs = math.max(0, os.time() - run.started)
      Controls.Elapsed.String = string.format("%d:%02d", secs // 60, secs % 60)
      local what
      if run.stopping then what = "Stopping..."
      elseif ap then what = "Waiting for your approval below"
      elseif run.clarify then what = "Hermes asked a question. Type the answer and press SEND."
      elseif run.status == "queued" then what = "Queued..."
      else what = "Working" .. (EVENT_TEXT[run.lastEvent or ""] and (": " .. EVENT_TEXT[run.lastEvent]) or "...") end
      Controls.RunState.String = what
    end
    renderHeader()
  end

  local function idle(msg)
    Controls.RunState.String = msg or "Ready"
  end

  -- runs -------------------------------------------------------------
  local runTimer = Timer.New()
  local finishRun

  local function parseApproval(t)
    -- Canonical gateway: GET /v1/runs/{id} carries pending_controls entries with
    -- prompt_id + execution_generation. Older single-process mode puts the
    -- approval.request event under "approval".
    if type(t.pending_controls) == "table" then
      for _, p in ipairs(t.pending_controls) do
        if type(p) == "table" and p.kind == "approval" then
          return { canonical = true, id = p.prompt_id, gen = p.execution_generation,
            command = str(p.command), description = str(p.description), choiceList = p.choices }
        end
      end
      return nil
    end
    local a = t.approval
    if t.status == "waiting_for_approval" and type(a) == "table" then
      return { canonical = false, id = type(a.request_id) == "string" and a.request_id or nil,
        command = str(a.command), description = str(a.description), choiceList = a.choices }
    end
    return nil
  end

  local function parseClarify(t)
    if type(t.pending_controls) ~= "table" then return nil end
    for _, p in ipairs(t.pending_controls) do
      if type(p) == "table" and p.kind == "clarify" then
        return { id = p.prompt_id, gen = p.execution_generation, question = str(p.question),
          choices = type(p.choices) == "table" and p.choices or {} }
      end
    end
    return nil
  end

  local function usageText(u)
    if type(u) ~= "table" then return "" end
    local s = string.format("in %s  out %s  total %s", tostring(u.input_tokens or "-"),
      tostring(u.output_tokens or "-"), tostring(u.total_tokens or "-"))
    if u.cache_read_tokens then s = s .. "  cache read " .. tostring(u.cache_read_tokens) end
    return s
  end

  local function runtimeText(r)
    if type(r) ~= "table" then return "" end
    local s = str(r.provider)
    if str(r.model) ~= "" then s = (s ~= "" and (s .. " / ") or "") .. r.model end
    return s
  end

  local pollRun

  local function handleRunStatus(t)
    if not run or t.run_id and t.run_id ~= run.id then return end
    local status = str(t.status)
    run.status = status
    run.lastEvent = str(t.last_event) ~= "" and t.last_event or run.lastEvent
    -- approval
    local ap = parseApproval(t)
    if ap then
      local choices = {}
      for _, c in ipairs(type(ap.choiceList) == "table" and ap.choiceList or { "once", "deny" }) do choices[c] = true end
      ap.choices = choices
      local what = ap.description ~= "" and ap.description or "Run a tool"
      ap.text = what .. (ap.command ~= "" and (": " .. ap.command) or "")
      if not run.approval or run.approval.id ~= ap.id then
        add("Hermes wants approval: " .. ap.text, "! ")
      end
    end
    run.approval = ap
    -- clarify
    local cl = parseClarify(t)
    if cl and run.clarifyShown ~= cl.id then
      run.clarifyShown = cl.id
      local q = cl.question
      if #cl.choices > 0 then q = q .. " (" .. table.concat(cl.choices, " / ") .. ")" end
      add(q, "? ")
    end
    run.clarify = cl
    if status == "completed" or status == "failed" or status == "cancelled" or status == "interrupted" then
      finishRun(t)
      return
    end
    if status == "unknown" and t.admission_id and t.execution_generation then
      -- The gateway restarted mid-turn and cannot finish it. Acknowledge so later
      -- turns in this session are not held behind it (resolve-unknown in the docs).
      request("POST", "/v1/runs/" .. run.id .. "/resolve-unknown",
        { admission_id = t.admission_id, execution_generation = t.execution_generation },
        function() end)
      add("The agent restarted during this turn, so its answer was lost. Send the prompt again.", "* ")
      finishRun(nil, "Lost (agent restarted)")
      return
    end
    if os.time() - run.started > MAX_TURN then
      add("No answer after " .. MAX_TURN .. " s. The plugin stopped waiting; Hermes may still finish it.", "* ")
      finishRun(nil, "Timed out")
      return
    end
    renderRun()
  end

  finishRun = function(t, note)
    runTimer:Stop()
    local r = run
    run = nil
    if t then
      local status = str(t.status)
      local output = str(t.output)
      Controls.LastUsage.String = usageText(t.usage)
      Controls.LastRuntime.String = runtimeText(t.runtime)
      if status == "completed" then
        add(output ~= "" and output or "(no text in the answer)")
        Controls.Response.String = output
        note = "Done"
      elseif status == "cancelled" then
        if output ~= "" then add(output) end
        add("Stopped.", "* ")
        note = "Stopped"
      else
        local err = str(t.error) ~= "" and t.error or status
        if output ~= "" then add(output) end
        add("Turn " .. status .. ": " .. err, "* ")
        setError("Turn " .. status .. ": " .. err)
        note = "Turn " .. status
      end
    end
    if r then
      local secs = os.time() - r.started
      Controls.Elapsed.String = string.format("%d:%02d", secs // 60, secs % 60)
    end
    renderRun()
    idle(note)
  end

  pollRun = function()
    if not run then runTimer:Stop(); return end
    local id = run.id
    request("GET", "/v1/runs/" .. id, nil, function(code, resp, err)
      if not run or run.id ~= id then return end
      if code == 200 then
        local t = decode(resp)
        if t then handleRunStatus(t) end
      elseif code == 404 then
        add("The agent no longer knows this turn (it may have restarted).", "* ")
        setError("GET /v1/runs/" .. id .. " returned 404")
        finishRun(nil, "Lost")
      elseif code == 401 then
        setError("401: API key refused")
        finishRun(nil, "API key refused")
      else
        renderRun()  -- transient: keep polling
      end
    end, { poll = true, timeout = 5 })
  end
  runTimer.EventHandler = pollRun

  local function startRun(text)
    text = trim(text)
    if text == "" then return end
    if host() == "" or apiKey() == "" then
      setError("Set the host and API key on the Setup page")
      idle("Not set up: see the Setup page")
      return
    end
    if run then
      if run.clarify and run.clarify.id then
        local cl, id = run.clarify, run.id
        add(text, "> ")
        request("POST", "/v1/runs/" .. id .. "/clarify",
          { request_id = cl.id, execution_generation = cl.gen, answer = text }, function(code, resp)
            if code ~= 200 then setError("Clarify answer refused (HTTP " .. tostring(code) .. ") " .. errorText(resp)) end
          end)
        run.clarify = nil
        renderRun()
        return
      end
      if not run.id then
        idle("Still sending the last prompt, try again in a moment")
        return
      end
      -- steer: add guidance to the running turn
      local id = run.id
      add(text, "+ ")
      request("POST", "/v1/runs/" .. id .. "/steer", { input = text }, function(code, resp)
        if code == 200 then return end
        if code == 409 then
          add("Hermes could not take that guidance now. Send it again after the answer.", "* ")
        else
          setError("Steer refused (HTTP " .. tostring(code) .. ") " .. errorText(resp))
        end
      end)
      return
    end
    if trim(Controls.SessionId.String) == "" then newSessionId() end
    local body = { input = text, session_id = trim(Controls.SessionId.String) }
    local instr = trim(Controls.Instructions.String)
    if instr ~= "" then body.instructions = instr end
    local model, provider = trim(Controls.Model.String), trim(Controls.Provider.String)
    if model ~= "" then body.model = model end
    if provider ~= "" then body.provider = provider end
    add(text, "> ")
    Controls.Response.String = ""
    run = { id = nil, started = os.time(), status = "queued" }
    local pending = run
    renderRun()
    request("POST", "/v1/runs", body, function(code, resp, err)
      if run ~= pending then return end
      local t = decode(resp)
      if (code == 202 or code == 200) and t and str(t.run_id) ~= "" then
        run.id = t.run_id
        Controls.LastRunId.String = t.run_id
        setError("")
        runTimer:Start(RUN_POLL)
        renderRun()
        return
      end
      local why
      if code == 401 then why = "API key refused (check API_SERVER_KEY)"
      elseif code == 429 then why = "Hermes is busy with other turns, try again shortly"
      elseif code == 409 then why = "Session refused: " .. errorText(resp) .. ". Press New Chat."
      elseif code == 503 then why = "Hermes is restarting or busy, try again shortly"
      elseif code == nil or code == 0 or err then why = "No answer from " .. baseUrl() .. " " .. tostring(err or "")
      else why = "HTTP " .. tostring(code) .. " " .. errorText(resp) end
      run = nil
      add("Not sent: " .. why, "* ")
      setError("POST /v1/runs: " .. why)
      renderRun()
      idle("Not sent")
    end, { timeout = 20, headers = { ["Idempotency-Key"] = "qsys-" .. randomHex(24) } })
  end

  local function stopRun()
    if not run or not run.id then return end
    run.stopping = true
    renderRun()
    local id = run.id
    request("POST", "/v1/runs/" .. id .. "/stop", {}, function(code, resp)
      if code ~= 200 and code ~= 202 then
        setError("Stop refused (HTTP " .. tostring(code) .. ") " .. errorText(resp))
        if run and run.id == id then run.stopping = false; renderRun() end
      end
    end)
  end

  local function answerApproval(choice)
    local ap = run and run.approval
    if not ap or not run.id then return end
    if choice == "session" and not ap.choices.session then return end
    local body
    if ap.canonical then
      body = { request_id = ap.id, execution_generation = ap.gen, choice = choice }
    else
      body = { choice = choice }
      if ap.id then body.request_id = ap.id end
    end
    local id = run.id
    request("POST", "/v1/runs/" .. id .. "/approval", body, function(code, resp)
      if code == 200 then
        add(choice == "deny" and "Denied." or ("Approved (" .. choice .. ")."), "* ")
      else
        setError("Approval refused (HTTP " .. tostring(code) .. ") " .. errorText(resp))
      end
    end)
    run.approval = nil
    renderRun()
  end

  -- connection -------------------------------------------------------
  local healthTimer = Timer.New()

  local function featureText()
    local f = features
    if f == nil then return "Unknown (no /v1/capabilities on this version)" end
    local out = {}
    local function mark(key, label) out[#out + 1] = label .. (f[key] and " yes" or " no") end
    mark("run_submission", "Runs"); mark("run_stop", "Stop"); mark("run_steer", "Steer")
    mark("run_approval_response", "Approvals")
    return table.concat(out, "   ")
  end

  local function checkAgent()
    request("GET", "/v1/models", nil, function(code, resp, err)
      if code == 200 then
        authOk = true
        local t = decode(resp)
        local m = t and type(t.data) == "table" and t.data[1]
        local name = (type(m) == "table" and str(m.id) ~= "") and m.id or "hermes-agent"
        Controls.AgentModel.String = name
        Controls.AgentName.String = name
        setError("")
        renderHeader()
        request("GET", "/v1/capabilities", nil, function(c2, r2)
          local t2 = c2 == 200 and decode(r2)
          features = (t2 and type(t2.features) == "table") and t2.features or nil
          Controls.Features.String = featureText()
          if features and features.run_submission == false then
            setStatus(2, "Runs API off")
            setError("This Hermes version does not offer the Runs API")
          end
        end)
      elseif code == 401 or code == 403 then
        authOk = false
        setStatus(2, "API key refused")
        setError("HTTP " .. code .. " from /v1/models: API key refused (API_SERVER_KEY, or the profile's own key)")
      else
        authOk = false
        setStatus(2, "No API")
        setError("/v1/models: " .. (code and ("HTTP " .. code .. " " .. errorText(resp)) or tostring(err)))
      end
    end)
  end

  local function healthCheck(force)
    if host() == "" then
      online = false
      setStatus(3, "Set host")
      Controls.Health.String = ""
      renderHeader()
      return
    end
    request("GET", "/health", nil, function(code, resp, err)
      local t = decode(resp)
      if code == 200 and t then
        local wasOnline = online
        online, healthFails = true, 0
        Controls.Health.String = "ok, " .. os.date("%H:%M:%S")
        if not wasOnline or force or not authOk then
          if apiKey() == "" then
            setStatus(3, "Set API key")
            setError("Enter the API key (API_SERVER_KEY) on the Setup page")
          else
            checkAgent()
          end
        end
      else
        healthFails = healthFails + 1
        Controls.Health.String = (code and code > 0) and ("HTTP " .. code) or ("no answer: " .. tostring(err or ""))
        if healthFails >= 2 or force or not online then
          online, authOk = false, false
          setStatus(2, "Offline")
          setError("No answer from " .. baseUrl() .. "/health. Is 'hermes gateway' running with API_SERVER_ENABLED?")
        end
      end
      renderHeader()
    end, { noAuth = true, poll = not force, timeout = 4 })
  end
  healthTimer.EventHandler = function() healthCheck(false) end

  local function connect()
    online, authOk, healthFails = false, false, 0
    features = {}
    Controls.Features.String = ""
    setStatus(5, "Connecting")
    healthCheck(true)
  end

  -- event handlers ---------------------------------------------------
  local function sendPrompt()
    local text = Controls.Prompt.String
    if trim(text) == "" then return end
    Controls.Prompt.String = ""
    startRun(text)
  end
  Controls.Send.EventHandler = sendPrompt
  Controls.Stop.EventHandler = stopRun
  Controls.NewChat.EventHandler = function()
    if run then
      if run.id then request("POST", "/v1/runs/" .. run.id .. "/stop", {}, function() end) end
      runTimer:Stop()
      run = nil
    end
    newSessionId()
    clearTranscript()
    Controls.Response.String = ""
    Controls.Elapsed.String = ""
    renderRun()
    idle("New conversation")
  end

  Controls.ApproveOnce.EventHandler = function() answerApproval("once") end
  Controls.ApproveSession.EventHandler = function() answerApproval("session") end
  Controls.Deny.EventHandler = function() answerApproval("deny") end

  Controls.TranscriptScroll.EventHandler = function(c)
    local maxOff = math.max(0, #lines - TRANSCRIPT_ROWS)
    offset = round((100 - c.Value) / 100 * maxOff)
    follow = offset >= maxOff
    renderTranscript()
  end
  Controls.ScrollUp.EventHandler = function()
    offset = offset - math.floor(TRANSCRIPT_ROWS / 2); follow = false; renderTranscript()
  end
  Controls.ScrollDown.EventHandler = function()
    offset = offset + math.floor(TRANSCRIPT_ROWS / 2); follow = false; renderTranscript()
  end

  local function presetLegend(i)
    local l = trim(Controls.PresetLabel[i].String)
    Controls.PresetSend[i].Legend = l ~= "" and l or ("Preset " .. i)
    Controls.PresetSend[i].IsDisabled = trim(Controls.PresetPrompt[i].String) == ""
  end
  for i = 1, PRESETS do
    Controls.PresetLabel[i].EventHandler = function() presetLegend(i) end
    Controls.PresetPrompt[i].EventHandler = function() presetLegend(i) end
    Controls.PresetSend[i].EventHandler = function() startRun(Controls.PresetPrompt[i].String) end
  end

  Controls.Connect.EventHandler = connect
  Controls.Host.EventHandler = connect
  Controls.ApiKey.EventHandler = connect
  Controls.Profile.EventHandler = connect

  -- startup ----------------------------------------------------------
  math.randomseed(os.time())
  -- A fresh instance (every preset empty) gets the example presets.
  local empty = true
  for i = 1, PRESETS do
    if trim(Controls.PresetLabel[i].String) ~= "" or trim(Controls.PresetPrompt[i].String) ~= "" then empty = false end
  end
  for i = 1, PRESETS do
    if empty then
      Controls.PresetLabel[i].String = DEFAULT_PRESETS[i][1]
      Controls.PresetPrompt[i].String = DEFAULT_PRESETS[i][2]
    end
    presetLegend(i)
  end
  if trim(Controls.SessionId.String) == "" then newSessionId() end
  Controls.AgentName.String = "Hermes Agent"
  clearTranscript()
  renderRun()
  idle("Ready")
  connect()
  healthTimer:Start(HEALTH_POLL)
end
